#: model:legal.letter.template,body:legal_department_management.ldm_letter_client_update
msgid ""
"Dear {client},\n"
"\n"
"We write to update you on matter {matter_number} ({matter}).\n"
"\n"
"Where it stands: ...\n"
"\n"
"What happens next: ...\n"
"\n"
"For any question, please contact {responsible}."
msgstr ""
"السادة {client} المحترمون،\n"
"\n"
"نود إعلامكم بآخر المستجدات في الملف المرقم {matter_number} ({matter}).\n"
"\n"
"الموقف الحالي: ...\n"
"\n"
"الخطوة القادمة: ...\n"
"\n"
"لأي استفسار يرجى التواصل مع {responsible}."

#. module: legal_department_management
#: model:legal.letter.template,body:legal_department_management.ldm_message_hearing_reminder
msgid ""
"Dear {client},\n"
"A reminder that the next session in {matter} ({matter_number}) is on {next_date} at {court}. {needed}\n"
"{office}"
msgstr ""
"السيد/السيدة {client} المحترم،\n"
"نذكّركم بأن الجلسة القادمة في {matter} ({matter_number}) يوم {next_date} أمام {court}. {needed}\n"
"{office}"

#. module: legal_department_management
#: model:legal.letter.template,body:legal_department_management.ldm_message_hearing_result
msgid ""
"Dear {client},\n"
"The session of {date} in {matter} ({matter_number}) at {court} ended as follows: {outcome}.\n"
"The next session is on {next_date}. {needed}\n"
"{responsible}, {office}"
msgstr ""
"السيد/السيدة {client} المحترم،\n"
"انتهت جلسة {date} في {matter} ({matter_number}) أمام {court} إلى: {outcome}.\n"
"موعد الجلسة القادمة {next_date}. {needed}\n"
"{responsible}، {office}"

#. module: legal_department_management
#: model:legal.letter.template,body:legal_department_management.ldm_message_missing_documents
