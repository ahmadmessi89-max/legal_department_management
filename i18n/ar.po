"Dear {client},\n"
"To continue {matter} ({matter_number}) we still need: {documents}.\n"
"Please send them as soon as you can.\n"
"{responsible}, {office}"
msgstr ""
"السيد/السيدة {client} المحترم،\n"
"لإكمال {matter} ({matter_number}) ما زلنا نحتاج: {documents}.\n"
"يرجى إرسالها بأقرب وقت.\n"
"{responsible}، {office}"

#. module: legal_department_management
#: model:legal.letter.template,body:legal_department_management.ldm_message_instalment_due
