<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Client file: SAG's company report rewritten in place (same xmlids and
        report name). Identifiers, the matters grouped by body, what is open
        and next, and the expenses for those who may see money. Its options
        come as report data from the "Client file" dialog; printed straight
        from the client it shows every matter the reader may open.
    -->
    <record id="paperformat_legal_compact_report" model="report.paperformat">
        <field name="name">Legal A4 (compact)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">52</field>
        <field name="margin_bottom">32</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">52</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_legal_company" model="ir.actions.report">
        <field name="name">Client file</field>
        <field name="model">legal.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_company_template</field>
        <field name="report_file">legal_department_management.report_legal_company_template</field>
        <field name="print_report_name">'Client file - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_legal_company"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_legal_compact_report"/>
    </record>

    <template id="report_ldm_matter_rows">
        <!-- One table of matters; ``rows`` and ``show_client`` are set by the caller. -->
        <table class="o_ldm_r_table">
            <thead>
                <tr>
                    <th>Matter</th>
                    <th t-if="show_client">Client</th>
                    <th t-if="show_body">Body or court</th>
                    <th>Responsible</th>
                    <th>Next</th>
                    <th>Status</th>
                    <th t-if="can_money" class="o_ldm_r_num">Expenses</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="rows" t-as="task">
                    <td>
                        <div><b t-out="task.name"/> <span t-if="task.is_urgent" class="o_ldm_r_badge">Urgent</span></div>
                        <div class="o_ldm_r_sub" t-out="task.task_number"/>
                    </td>
                    <td t-if="show_client" t-out="task.legal_company_id.name"/>
                    <td t-if="show_body" t-out="task.department_id.name or '–'"/>
                    <td t-out="task.lawyer_id.name or ''"/>
                    <td>
                        <t t-if="task.next_date">
                            <div t-att-class="'o_ldm_r_nowrap o_ldm_r_late' if task.next_date &lt; today else 'o_ldm_r_nowrap'" t-out="fdate(task.next_date)"/>
                            <div class="o_ldm_r_sub" t-out="task.next_action or ''"/>
                        </t>
                        <span t-else="" class="o_ldm_r_muted">–</span>
                    </td>
                    <td><span t-field="task.state"/></td>
                    <td t-if="can_money" class="o_ldm_r_num" t-out="money(task.expenses_amount, task.company_currency_id)"/>
                </tr>
            </tbody>
        </table>
    </template>

    <template id="report_legal_company_document">
        <t t-set="file" t-value="files.get(doc.id, {})"/>
        <t t-call="web.external_layout">
            <div class="page o_ldm_r" t-att-dir="ldm_dir">
                <t t-call="legal_department_management.report_ldm_style"/>
                <div class="o_ldm_r_kicker">Client file</div>
                <h2 t-out="doc.name"/>
                <div class="o_ldm_r_sub">
                    Printed on <span t-out="fdate(today)"/>
                    <t t-foreach="filter_lines" t-as="line"> · <span t-out="line[0]"/>: <span t-out="line[1]"/></t>
                </div>

                <t t-if="show_identifiers">
                    <table class="o_ldm_r_facts">
                        <tr>
                            <td class="o_ldm_r_label">Client is</td>
                            <td>
                                <span t-field="doc.client_kind"/>
                                <t t-if="doc.client_kind == 'company' and doc.company_type"> · <span t-field="doc.company_type"/></t>
                            </td>
                            <td class="o_ldm_r_label">Responsible</td>
                            <td t-out="doc.lawyer_id.name or '–'"/>
                        </tr>
                        <tr t-if="doc.registration_number or doc.tax_number">
                            <td class="o_ldm_r_label">Registration number</td>
                            <td t-out="doc.registration_number or '–'"/>
                            <td class="o_ldm_r_label">Tax number</td>
                            <td t-out="doc.tax_number or '–'"/>
                        </tr>
                        <tr t-if="doc.social_security_number or doc.chamber_number">
                            <td class="o_ldm_r_label">Social security number</td>
                            <td t-out="doc.social_security_number or '–'"/>
                            <td class="o_ldm_r_label">Chamber of commerce ID</td>
                            <td>
                                <span t-out="doc.chamber_number or '–'"/>
                                <span t-if="doc.chamber_grade" class="o_ldm_r_sub"> · <span t-out="doc.chamber_grade"/></span>
                            </td>
                        </tr>
                        <tr t-if="doc.owner_name or doc.entity_type or doc.national_id">
                            <td class="o_ldm_r_label" t-if="doc.client_kind == 'individual'">National ID</td>
                            <td t-if="doc.client_kind == 'individual'" t-out="doc.national_id or '–'"/>
                            <td class="o_ldm_r_label" t-if="doc.client_kind != 'individual'">Managing director</td>
                            <td t-if="doc.client_kind != 'individual'" t-out="doc.owner_name or '–'"/>
                            <td class="o_ldm_r_label">Business activity</td>
                            <td t-out="doc.entity_type or '–'"/>
                        </tr>
                        <tr t-if="doc.phone or doc.email or doc.address">
                            <td class="o_ldm_r_label">Contact</td>
                            <td>
                                <span t-out="doc.phone or ''"/>
                                <span t-if="doc.email"> · <span t-out="doc.email"/></span>
                            </td>
                            <td class="o_ldm_r_label">Address</td>
                            <td t-out="doc.address or '–'"/>
                        </tr>
                    </table>
                </t>

                <table class="o_ldm_r_summary">
                    <tr>
                        <td>Open matters: <b t-out="file.get('open_count', 0)"/></td>
                        <td>Done or cancelled: <b t-out="file.get('closed_count', 0)"/></td>
                        <td t-if="can_money">
                            Expenses:
                            <t t-if="not file.get('expenses')"><b>–</b></t>
                            <t t-foreach="file.get('expenses', [])" t-as="pair"><b t-out="money(pair[1], pair[0])"/> </t>
                        </td>
                    </tr>
                </table>

                <t t-if="not file.get('tasks')">
                    <div class="o_ldm_r_empty">No matter matches these options.</div>
                </t>
                <t t-else="">
                    <t t-if="file.get('open_items')">
                        <div class="o_ldm_r_section">What is open and next</div>
                        <table class="o_ldm_r_table">
                            <thead><tr><th>Date</th><th>Matter</th><th>What</th></tr></thead>
                            <tbody>
                                <tr t-foreach="file['open_items']" t-as="item">
                                    <td t-att-class="'o_ldm_r_nowrap o_ldm_r_late' if item['date'] &lt; today else 'o_ldm_r_nowrap'" t-out="fdate(item['date'])"/>
                                    <td>
                                        <span t-out="item['task'].name"/>
                                        <span class="o_ldm_r_sub"> · <span t-out="item['task'].task_number"/></span>
                                    </td>
                                    <td t-out="item['text']"/>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                    <t t-foreach="file['by_body']" t-as="group">
                        <div class="o_ldm_r_section">
                            <t t-if="group[0]"><span t-out="group[0].name"/></t><t t-else="">No body or court</t> · <span t-out="len(group[1])"/>
                        </div>
                        <t t-set="rows" t-value="group[1]"/>
                        <t t-set="show_client" t-value="False"/>
                        <t t-set="show_body" t-value="False"/>
                        <t t-call="legal_department_management.report_ldm_matter_rows"/>
                    </t>
                </t>

                <table class="o_ldm_r_sign">
                    <tr>
                        <td>
                            <div>Responsible</div>
                            <div class="o_ldm_r_sign_name" t-out="doc.lawyer_id.name or ''"/>
                            <div class="o_ldm_r_sign_line">Signature</div>
                        </td>
                        <td>
                            <div>Legal manager</div>
                            <div class="o_ldm_r_sign_name"/>
                            <div class="o_ldm_r_sign_line">Signature and stamp</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_legal_company_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="legal_department_management.report_legal_company_document"/>
            </t>
        </t>
    </template>
</odoo>
