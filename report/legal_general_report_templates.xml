<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Oversight report: SAG's general report rewritten in place (same xmlids
        and report name). Matters across clients, grouped by client when asked
        (the old toggle did nothing). Options come as report data from the
        dialog; printed straight from a selection of matters it lists those.
    -->
    <record id="paperformat_legal_compact_general_report" model="report.paperformat">
        <field name="name">Legal A4 landscape (oversight)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">40</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="True"/>
    </record>

    <record id="action_report_legal_general_overview" model="ir.actions.report">
        <field name="name">Oversight report</field>
        <field name="model">legal.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_general_overview_template</field>
        <field name="report_file">legal_department_management.report_legal_general_overview_template</field>
        <field name="print_report_name">'Oversight report'</field>
        <field name="paperformat_id" ref="paperformat_legal_compact_general_report"/>
    </record>

    <template id="report_legal_general_overview_document">
        <t t-call="web.external_layout">
            <div class="page o_ldm_r" t-att-dir="ldm_dir">
                <t t-call="legal_department_management.report_ldm_style"/>
                <div class="o_ldm_r_kicker">Oversight report</div>
                <h2 t-out="scope"/>
                <div class="o_ldm_r_sub">
                    Printed on <span t-out="fdate(today)"/> by <span t-out="user.name"/>
                    <t t-foreach="filter_lines" t-as="line"> · <span t-out="line[0]"/>: <span t-out="line[1]"/></t>
                </div>

                <table class="o_ldm_r_summary">
                    <tr>
                        <td>Matters: <b t-out="len(tasks)"/></td>
                        <td>Clients: <b t-out="client_count"/></td>
                        <td>Open: <b t-out="open_count"/></td>
                        <td>Past their target date: <b t-att-class="'o_ldm_r_late' if overdue_count else None" t-out="overdue_count"/></td>
                        <td t-if="can_money">
                            Expenses:
                            <t t-if="not expenses"><b>–</b></t>
                            <t t-foreach="expenses" t-as="pair"><b t-out="money(pair[1], pair[0])"/> </t>
                        </td>
                    </tr>
                </table>

                <div t-if="not tasks" class="o_ldm_r_empty">No matter matches these options.</div>
                <t t-foreach="groups" t-as="group">
                    <div t-if="group_by_client" class="o_ldm_r_section">
                        <span t-out="group[0].name"/> · <span t-out="len(group[1])"/>
                    </div>
                    <t t-set="rows" t-value="group[1]"/>
                    <t t-set="show_client" t-value="not group_by_client"/>
                    <t t-set="show_body" t-value="True"/>
                    <t t-call="legal_department_management.report_ldm_matter_rows"/>
                </t>

                <table class="o_ldm_r_sign" t-if="tasks">
                    <tr>
                        <td>
                            <div>Prepared by</div>
                            <div class="o_ldm_r_sign_name" t-out="user.name"/>
                            <div class="o_ldm_r_sign_line">Signature</div>
                        </td>
                        <td>
                            <div>Legal manager</div>
                            <div class="o_ldm_r_sign_name"/>
                            <div class="o_ldm_r_sign_line">Signature and stamp</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_legal_general_overview_template">
        <t t-call="web.html_container">
            <t t-call="legal_department_management.report_legal_general_overview_document"/>
        </t>
    </template>
</odoo>
