<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat with minimal zero-waste top margin -->
    <record id="paperformat_legal_compact_general_report" model="report.paperformat">
        <field name="name">تقرير الرقابة العامة المضغوط</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">12</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- General Report Action -->
    <record id="action_report_legal_general_overview" model="ir.actions.report">
        <field name="name">تقرير الرقابة العامة الشامل للقضايا</field>
        <field name="model">legal.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_general_overview_template</field>
        <field name="report_file">legal_department_management.report_legal_general_overview_template</field>
        <field name="print_report_name">'تقرير_الرقابة_العامة_للقضايا_' + time.strftime('%Y%m%d')</field>
        <field name="paperformat_id" ref="paperformat_legal_compact_general_report"/>
    </record>

    <template id="report_legal_general_overview_document">
        <t t-call="web.basic_layout">
            <div class="page" dir="rtl" style="font-family: 'Cairo', 'Segoe UI', Tahoma, sans-serif; font-size: 11.5px; color: #212529; padding: 0; margin: 0;">
                
                <t t-set="report_data" t-value="env.context.get('report_data', {})"/>
                <t t-set="task_ids" t-value="report_data.get('task_ids', [])"/>
                <t t-set="tasks" t-value="env['legal.task'].browse(task_ids)"/>
                <t t-set="companies" t-value="tasks.mapped('legal_company_id')"/>

                <!-- Ultra Compact Header -->
                <div style="border-bottom: 2px solid #0d6efd; padding-bottom: 4px; margin-bottom: 8px;" class="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 style="margin: 0; color: #0d6efd; font-weight: bold; font-size: 17px;">
                            تقرير الرقابة العامة على القضايا والمعاملات القانونية
                        </h3>
                        <div style="font-size: 10.5px; color: #6c757d;">
                            نطاق التقرير: <strong class="text-dark"><span t-esc="report_data.get('company_names', 'كافة الشركات')"/></strong>
                            <t t-if="report_data.get('filter_department_name') != 'كافة الدوائر الرسمية'"> | الدائرة: <strong class="text-primary"><span t-esc="report_data.get('filter_department_name')"/></strong></t>
                            <t t-if="report_data.get('filter_lawyer_name') != 'كافة المحامين'"> | المحامي: <strong class="text-primary"><span t-esc="report_data.get('filter_lawyer_name')"/></strong></t>
                            <t t-if="report_data.get('filter_state_label') != 'كافة الحالات'"> | الحالة: <strong class="text-primary"><span t-esc="report_data.get('filter_state_label')"/></strong></t>
                        </div>
                    </div>
                    <div class="text-start" style="font-size: 10.5px; color: #495057;">
                        <div>تاريخ الإصدار: <strong><span t-esc="datetime.date.today().strftime('%Y-%m-%d')"/></strong></div>
                        <div>الجهة المصدرة: <strong>الإدارة القانونية العامة</strong></div>
                    </div>
                </div>

                <!-- Compact Summary Stats Bar -->
                <div class="row g-2 text-center mb-2" style="font-size: 11px;">
                    <div class="col-3">
                        <div style="border: 1px solid #cfe2ff; background-color: #f0f7ff; padding: 4px; border-radius: 3px;">
                            <span>الشركات المشمولة: </span>
                            <strong class="text-primary"><span t-esc="len(companies)"/></strong>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border: 1px solid #cfe2ff; background-color: #f0f7ff; padding: 4px; border-radius: 3px;">
                            <span>إجمالي المعاملات: </span>
                            <strong class="text-primary"><span t-esc="len(tasks)"/></strong>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border: 1px solid #fff3cd; background-color: #fffdf5; padding: 4px; border-radius: 3px;">
                            <span>المعاملات الجارية: </span>
                            <strong class="text-warning"><span t-esc="len(tasks.filtered(lambda t: t.state in ['draft', 'in_progress', 'pending_docs']))"/></strong>
                        </div>
                    </div>
                    <div class="col-3">
                        <div style="border: 1px solid #d1e7dd; background-color: #f3fbf6; padding: 4px; border-radius: 3px;">
                            <span>إجمالي المصروفات: </span>
                            <strong class="text-success"><span t-esc="sum(tasks.mapped('expenses_amount'))"/> د.ع</strong>
                        </div>
                    </div>
                </div>

                <!-- Main Table (Grouped by Company or Continuous) -->
                <table class="table table-sm table-bordered text-center align-middle mb-2" style="border-collapse: collapse; width: 100%; font-size: 10.5px;">
                    <thead style="background-color: #f1f4f9; border-bottom: 2px solid #b6c5d6;">
                        <tr>
                            <th style="width: 4%; padding: 4px;">ت</th>
                            <th style="width: 23%; padding: 4px;">عنوان الإجراء / المعاملة</th>
                            <th style="width: 17%; padding: 4px;">الشركة التابعة</th>
                            <th style="width: 16%; padding: 4px;">الدائرة / القسم</th>
                            <th style="width: 13%; padding: 4px;">المحامون المكلفون</th>
                            <th style="width: 10%; padding: 4px;">تاريخ الجلسة</th>
                            <th style="width: 10%; padding: 4px;">تاريخ الاستحقاق</th>
                            <th style="width: 7%; padding: 4px;">المصروفات</th>
                            <th style="width: 7%; padding: 4px;">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="not tasks">
                            <tr>
                                <td colspan="9" class="text-muted py-3" style="padding: 10px;">لا توجد معاملات مطابقة للفلترة المحددة في النظام.</td>
                            </tr>
                        </t>
                        <t t-foreach="tasks" t-as="task">
                            <tr>
                                <td style="padding: 3px;"><span t-esc="task_index + 1"/></td>
                                <td class="text-end fw-bold text-primary" style="padding: 3px 5px;">
                                    <span t-if="task.is_urgent" style="color: #dc3545; margin-left: 2px;">⚠️</span>
                                    <span t-field="task.name"/>
                                </td>
                                <td style="padding: 3px;" class="fw-bold"><span t-field="task.legal_company_id.name"/></td>
                                <td style="padding: 3px;"><span t-field="task.department_id.name"/></td>
                                <td style="padding: 3px;"><span t-esc="', '.join(task.lawyer_ids.mapped('name')) if task.lawyer_ids else (task.lawyer_id.name or '-')"/></td>
                                <td style="padding: 3px;"><span t-esc="task.session_date or '-'"/></td>
                                <td style="padding: 3px;"><span t-esc="task.due_date or '-'"/></td>
                                <td class="fw-bold text-success" style="padding: 3px;"><span t-field="task.expenses_amount"/> د.ع</td>
                                <td style="padding: 3px;">
                                    <span t-if="task.state == 'draft'">مسودة</span>
                                    <span t-if="task.state == 'in_progress'" class="text-info fw-bold">قيد الإجراء</span>
                                    <span t-if="task.state == 'pending_docs'" class="text-warning fw-bold">بانتظار وثائق</span>
                                    <span t-if="task.state == 'done'" class="text-success fw-bold">منجز ✓</span>
                                    <span t-if="task.state == 'cancelled'" class="text-danger">ملغى</span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <t t-if="tasks">
                        <tfoot style="background-color: #f8f9fa; font-weight: bold;">
                            <tr>
                                <td colspan="7" class="text-end pe-3" style="padding: 4px;">إجمالي المصروفات والرسوم المدفوعة لكافة القضايا:</td>
                                <td class="text-success fw-bold" style="padding: 4px;"><span t-esc="sum(tasks.mapped('expenses_amount'))"/> د.ع</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </t>
                </table>

                <!-- Signatures -->
                <div class="row mt-3 pt-2" style="font-size: 11px;">
                    <div class="col-6 text-center">
                        <p class="fw-bold mb-1">إعداد وقسم المتابعة القانونية</p>
                        <p class="text-primary fw-bold mb-3"><span t-esc="env.user.name"/></p>
                        <p class="text-muted">التوقيع: _______________________</p>
                    </div>
                    <div class="col-6 text-center">
                        <p class="fw-bold mb-1">مصادقة المدير القانوني العام / مدير النظام</p>
                        <br/>
                        <p class="text-muted">الختم والتوقيع: _______________________</p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_legal_general_overview_template">
        <t t-call="web.html_container">
            <t t-call="legal_department_management.report_legal_general_overview_document"/>
        </t>
    </template>
</odoo>
