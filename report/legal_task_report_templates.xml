<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Follow-up sheet (استمارة متابعة): the page a runner carries to the
        counter. SAG's report, rewritten in place (same xmlids and report name):
        the matter at a glance, the steps with boxes to tick, the documents,
        the sessions and visits, the expenses, ruled rows for what the counter
        said, and a QR code that opens the matter.
    -->
    <record id="action_report_legal_task" model="ir.actions.report">
        <field name="name">Follow-up sheet</field>
        <field name="model">legal.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_task_template</field>
        <field name="report_file">legal_department_management.report_legal_task_template</field>
        <field name="print_report_name">'Follow-up sheet - %s' % (object.task_number or object.name or '')</field>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_legal_compact_report"/>
    </record>

    <template id="report_legal_task_document">
        <t t-call="web.external_layout">
            <div class="page o_ldm_r" t-att-dir="ldm_dir">
                <t t-call="legal_department_management.report_ldm_style"/>
                <table class="o_ldm_r_facts">
                    <tr>
                        <td>
                            <div class="o_ldm_r_kicker">Follow-up sheet</div>
                            <h2 t-out="doc.name"/>
                            <div class="o_ldm_r_sub">
                                <span t-out="doc.task_number"/> · <span t-field="doc.kind"/>
                                <t t-if="doc.is_urgent"> · <span class="o_ldm_r_badge">Urgent</span></t>
                            </div>
                        </td>
                        <td class="o_ldm_r_num">
                            <img class="o_ldm_r_qr" t-att-src="qr(record_url(doc, 'matters'))" alt="QR code of the matter"/>
                        </td>
                    </tr>
                </table>

                <table class="o_ldm_r_facts">
                    <tr>
                        <td class="o_ldm_r_label">Client</td>
                        <td t-out="doc.legal_company_id.name"/>
                        <td class="o_ldm_r_label">Status</td>
                        <td><span t-field="doc.state"/></td>
                    </tr>
                    <tr>
                        <td class="o_ldm_r_label">Body or court</td>
                        <td>
                            <span t-out="doc.department_id.name or '–'"/>
                            <span t-if="doc.ministry_id" class="o_ldm_r_sub"> · <span t-out="doc.ministry_id.name"/></span>
                        </td>
                        <td class="o_ldm_r_label">Responsible</td>
                        <td t-out="doc.lawyer_id.name or '–'"/>
                    </tr>
                    <tr>
                        <td class="o_ldm_r_label">Opened on</td>
                        <td t-out="fdate(doc.date_opened)"/>
                        <td class="o_ldm_r_label">Target date</td>
                        <td t-out="fdate(doc.due_date) or '–'"/>
                    </tr>
                    <tr t-if="doc.next_date">
                        <td class="o_ldm_r_label">Next</td>
                        <td colspan="3">
                            <b t-out="fdate(doc.next_date)"/> · <span t-out="doc.next_action or ''"/>
                        </td>
                    </tr>
                    <tr t-if="doc.court_case_number or doc.reference">
                        <td class="o_ldm_r_label" t-if="doc.court_case_number">Court case number</td>
                        <td t-if="doc.court_case_number" t-out="doc.court_case_number"/>
                        <td class="o_ldm_r_label" t-if="doc.reference">Body's transaction number</td>
                        <td t-if="doc.reference" t-out="doc.reference"/>
                    </tr>
                </table>

                <t t-if="doc.step_ids">
                    <div class="o_ldm_r_section">Steps</div>
                    <table class="o_ldm_r_table">
                        <thead>
                            <tr>
                                <th/>
                                <th>Step</th>
                                <th>Due</th>
                                <th>Assigned to</th>
                                <th>Done on · receipt</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.step_ids" t-as="step">
                                <td>
                                    <span t-att-class="'o_ldm_r_tick o_ldm_r_tick_done' if step.state == 'done' else ('o_ldm_r_tick o_ldm_r_tick_skip' if step.state == 'skipped' else 'o_ldm_r_tick')"/>
                                </td>
                                <td>
                                    <span t-out="step.name"/>
                                    <span t-if="step.is_visit" class="o_ldm_r_badge">Visit</span>
                                </td>
                                <td t-att-class="'o_ldm_r_nowrap o_ldm_r_late' if step.is_overdue else 'o_ldm_r_nowrap'" t-out="fdate(step.date_due)"/>
                                <td t-out="step.user_id.name or ''"/>
                                <td class="o_ldm_r_nowrap">
                                    <span t-out="fdate(step.done_date)"/>
                                    <span t-if="step.receipt_number"> · <span t-out="step.receipt_number"/></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-if="doc.document_ids">
                    <div class="o_ldm_r_section">Documents to collect</div>
                    <table class="o_ldm_r_table">
                        <thead>
                            <tr><th/><th>Document</th><th>Status</th><th>Expires on</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.document_ids" t-as="document">
                                <td>
                                    <span t-att-class="'o_ldm_r_tick o_ldm_r_tick_done' if document.state in ('received', 'verified') else ('o_ldm_r_tick o_ldm_r_tick_skip' if document.state == 'not_needed' else 'o_ldm_r_tick')"/>
                                </td>
                                <td>
                                    <span t-out="document.name"/>
                                    <span t-if="not document.mandatory" class="o_ldm_r_sub"> (optional)</span>
                                </td>
                                <td t-att-class="'o_ldm_r_late' if document.state in ('missing', 'expired') and document.mandatory else None">
                                    <span t-field="document.state"/>
                                </td>
                                <td class="o_ldm_r_nowrap" t-out="fdate(document.expiry_date)"/>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-set="visits" t-value="doc.step_ids.filtered(lambda s: s.is_visit and s.state == 'done')"/>
                <t t-if="doc.hearing_ids or visits">
                    <div class="o_ldm_r_section">Sessions and visits</div>
                    <table class="o_ldm_r_table">
                        <thead>
                            <tr><th>Date</th><th>Where</th><th>Who</th><th>Status</th><th>Outcome</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.hearing_ids.sorted('date')" t-as="hearing">
                                <td class="o_ldm_r_nowrap" t-out="fdate(hearing.date)"/>
                                <td>
                                    <span t-out="hearing.department_id.name or doc.department_id.name or ''"/>
                                    <span t-if="hearing.court_room" class="o_ldm_r_sub"> · <span t-out="hearing.court_room"/></span>
                                </td>
                                <td t-out="hearing.attending_user_id.name or hearing.substitute_partner_id.name or ''"/>
                                <td><span t-field="hearing.state"/></td>
                                <td><span t-field="hearing.outcome"/></td>
                            </tr>
                            <tr t-foreach="visits" t-as="visit">
                                <td class="o_ldm_r_nowrap" t-out="fdate(visit.done_date or visit.date_due)"/>
                                <td t-out="visit.department_id.name or doc.department_id.name or ''"/>
                                <td t-out="visit.done_by_id.name or visit.user_id.name or ''"/>
                                <td>Visit</td>
                                <td>
                                    <span t-field="visit.visit_result"/>
                                    <span t-if="visit.receipt_number" class="o_ldm_r_sub"> · <span t-out="visit.receipt_number"/></span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>

                <t t-if="doc.expense_ids">
                    <div class="o_ldm_r_section">Expenses</div>
                    <table class="o_ldm_r_table">
                        <thead>
                            <tr><th>Date</th><th>What</th><th>Receipt</th><th class="o_ldm_r_num">Amount</th></tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="doc.expense_ids" t-as="expense">
                                <td class="o_ldm_r_nowrap" t-out="fdate(expense.date)"/>
                                <td>
                                    <span t-out="expense.name"/>
                                    <span t-if="expense.category_id" class="o_ldm_r_sub"> · <span t-out="expense.category_id.name"/></span>
                                </td>
                                <td t-out="expense.receipt_number or ''"/>
                                <td class="o_ldm_r_num" t-out="money(expense.amount, expense.currency_id)"/>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3">Total</td>
                                <td class="o_ldm_r_num" t-out="money(doc.expenses_amount, doc.company_currency_id)"/>
                            </tr>
                        </tfoot>
                    </table>
                </t>

                <t t-if="can_notes and doc.action_details">
                    <div class="o_ldm_r_section">Notes</div>
                    <div class="o_ldm_r_note" t-out="doc.action_details"/>
                </t>

                <div class="o_ldm_r_section">At the counter</div>
                <table class="o_ldm_r_table o_ldm_r_ruled">
                    <thead>
                        <tr><th>Date</th><th>Counter or office</th><th>Whom we met</th><th>What was said</th><th>Next step</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="range(6)" t-as="row"><td/><td/><td/><td/><td/></tr>
                    </tbody>
                </table>

                <table class="o_ldm_r_sign">
                    <tr>
                        <td>
                            <div>Responsible</div>
                            <div class="o_ldm_r_sign_name" t-out="doc.lawyer_id.name or ''"/>
                            <div class="o_ldm_r_sign_line">Signature</div>
                        </td>
                        <td>
                            <div>Legal manager</div>
                            <div class="o_ldm_r_sign_name" t-out="doc.approver_id.name or ''"/>
                            <div class="o_ldm_r_sign_line">Signature and stamp</div>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_legal_task_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="legal_department_management.report_legal_task_document"/>
            </t>
        </t>
    </template>
</odoo>
