<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PDF Report Action for Legal Company Dossier -->
    <record id="action_report_legal_company" model="ir.actions.report">
        <field name="name">تقرير شامل لملف الشركة والقضايا</field>
        <field name="model">legal.company</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_company_template</field>
        <field name="report_file">legal_department_management.report_legal_company_template</field>
        <field name="print_report_name">'تقرير_شركة_' + (object.name or '')</field>
        <field name="binding_model_id" ref="model_legal_company"/>
        <field name="binding_type">report</field>
    </record>

    <!-- PDF Report Action for Legal Tasks -->
    <record id="action_report_legal_task" model="ir.actions.report">
        <field name="name">استمارة متابعة القضية / المعاملة</field>
        <field name="model">legal.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_legal_task_template</field>
        <field name="report_file">legal_department_management.report_legal_task_template</field>
        <field name="print_report_name">'استمارة_إجراء_قانوني_' + (object.name or '')</field>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
