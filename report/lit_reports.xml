<?xml version="1.0" encoding="utf-8"?>
<!-- Owned by the lit stream (docs/ldm/SPEC.md section 11). -->
<odoo>
    <record id="paperformat_ldm_roll" model="report.paperformat">
        <field name="name">Legal: hearing roll (A4 landscape)</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">32</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">26</field>
        <field name="dpi">90</field>
    </record>

    <!-- The hearing roll (رول الجلسات): the sessions of a range of days, by
         court and then by the lawyer attending. Printed from the Agenda, from
         Reporting, or from a selection of sessions. -->
    <record id="action_report_ldm_hearing_roll" model="ir.actions.report">
        <field name="name">Hearing roll</field>
        <field name="model">legal.hearing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_ldm_hearing_roll</field>
        <field name="report_file">legal_department_management.report_ldm_hearing_roll</field>
        <field name="print_report_name">'Hearing roll'</field>
        <field name="binding_model_id" ref="model_legal_hearing"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_ldm_roll"/>
    </record>

    <template id="report_ldm_hearing_roll">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page o_ldm_report">
                    <h3 class="mb-0">Hearing roll</h3>
                    <p class="text-muted mb-3">
                        <span t-out="period"/>
                        <span t-if="period"> · </span>
                        <span t-out="count"/> <span>sessions</span>
                        <span> · </span><span>printed on</span> <span t-out="printed_on"/>
                    </p>
                    <p t-if="not groups" class="text-muted">No court sessions in this period.</p>
                    <t t-foreach="groups" t-as="group">
                        <h5 class="mt-3 mb-1 border-bottom pb-1" t-out="group['court_name']"/>
                        <t t-foreach="group['lawyers']" t-as="lawyer">
                            <p class="fw-bold mt-2 mb-1" t-out="lawyer['name']"/>
                            <table class="table table-sm table-bordered o_main_table mb-2">
                                <thead>
                                    <tr>
                                        <th class="text-nowrap">Date</th>
                                        <th class="text-nowrap">Time</th>
                                        <th class="text-nowrap">Case number</th>
                                        <th>Matter</th>
                                        <th>Client</th>
                                        <th>Other side</th>
                                        <th>Purpose</th>
                                        <th>Needed before</th>
                                        <th>Substitute</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="lawyer['rows']" t-as="row">
                                        <td class="text-nowrap" t-out="row['date']"/>
                                        <td class="text-nowrap" t-out="row['time']"/>
                                        <td class="text-nowrap" t-out="row['case']"/>
                                        <td>
                                            <span t-out="row['number']"/>
                                            <div t-if="row['role']" class="text-muted small" t-out="row['role']"/>
                                        </td>
                                        <td t-out="row['client']"/>
                                        <td t-out="row['opponent']"/>
                                        <td>
                                            <span t-out="row['purpose']"/>
                                            <div t-if="row['room']" class="text-muted small">
                                                <span>Room</span> <span t-out="row['room']"/>
                                            </div>
                                        </td>
                                        <td t-out="row['needed']"/>
                                        <td>
                                            <span t-out="row['substitute']"/>
                                            <div t-if="row['letter']" class="small fw-bold">Substitution letter needed</div>
                                            <div t-if="row['warning']" class="small text-danger" t-out="row['warning']"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- The substitution letter (كتاب إنابة): the agent under the matter's power
         of attorney authorises another lawyer to attend one session. -->
    <record id="action_report_ldm_substitution" model="ir.actions.report">
        <field name="name">Substitution letter</field>
        <field name="model">legal.hearing</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">legal_department_management.report_ldm_substitution</field>
        <field name="report_file">legal_department_management.report_ldm_substitution</field>
        <field name="print_report_name">'Substitution letter - %s' % (object.date or '')</field>
        <field name="binding_model_id" ref="model_legal_hearing"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_ldm_substitution">
        <t t-call="web.html_container">
            <t t-foreach="letters" t-as="letter">
                <t t-set="o" t-value="letter['hearing']"/>
                <t t-call="web.external_layout">
                    <div class="page o_ldm_report">
                        <p class="text-end mb-4">
                            <span>Date:</span> <span t-out="letter['today']"/>
                        </p>
                        <p class="fw-bold mb-1" t-if="letter['court']">
                            <span>To:</span> <span t-out="letter['court']"/>
                        </p>
                        <h4 class="text-center my-4">Substitution letter</h4>
                        <p class="lh-lg" t-out="letter['body']"/>
                        <p class="lh-lg">This letter is valid for that session only.</p>
                        <div class="row mt-5">
                            <div class="col-6">
                                <p class="mb-1">Lawyer giving the substitution</p>
                                <p class="fw-bold mb-1" t-out="letter['principal'].name"/>
                                <p t-if="letter['bar_number']" class="mb-4">
                                    <span>Bar membership no.</span> <span t-out="letter['bar_number']"/>
                                </p>
                                <p class="mt-4">Signature</p>
                            </div>
                            <div class="col-6">
                                <p class="mb-1">Substitute lawyer</p>
                                <p class="fw-bold mb-4" t-out="letter['substitute']"/>
                                <p class="mt-4">Signature</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
