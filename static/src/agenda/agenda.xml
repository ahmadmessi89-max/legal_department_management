<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_department_management.Agenda">
        <Layout className="'o_ldm o_ldm_agenda_screen'" display="{}">
            <div class="o_ldm_state" t-if="!state.data &amp;&amp; !state.error" role="status">
                <span class="o_ldm_spinner" aria-hidden="true"/>
                <span t-esc="label.loading"/>
            </div>
            <div class="o_ldm_state o_ldm_state_error" t-if="state.error" role="alert">
                <i class="fa fa-exclamation-circle" role="img" t-att-title="label.error"/>
                <div>
                    <p class="o_ldm_state_title" t-esc="label.error"/>
                    <button type="button" class="btn btn-primary btn-sm" t-on-click="() => this.load()" t-esc="label.retry"/>
                </div>
            </div>
            <div class="o_ldm_agenda" t-if="state.data">
                <header class="o_ldm_ag_head">
                    <div>
                        <h1 class="o_ldm_ag_title" t-esc="label.title"/>
                        <p class="o_ldm_ag_meta">
                            <span t-esc="label.subtitle"/>
                            <span aria-hidden="true">·</span>
                            <span t-esc="range"/>
                        </p>
                    </div>
                    <div class="o_ldm_ag_tools">
                        <div class="o_ldm_md_scopes" role="tablist">
                            <button type="button" role="tab"
                                    t-att-class="{'o_ldm_md_scope': true, 'o_ldm_md_scope_on': state.scope === 'me'}"
                                    t-att-aria-selected="state.scope === 'me' ? 'true' : 'false'"
                                    t-on-click="() => this.setScope('me')" t-esc="label.me"/>
                            <button type="button" role="tab"
                                    t-att-class="{'o_ldm_md_scope': true, 'o_ldm_md_scope_on': state.scope === 'all'}"
                                    t-att-aria-selected="state.scope === 'all' ? 'true' : 'false'"
                                    t-on-click="() => this.setScope('all')" t-esc="label.all"/>
                        </div>
                        <button type="button" class="btn btn-secondary" t-on-click="openMonth">
                            <i class="fa fa-calendar" role="img" aria-hidden="true"/>
                            <span class="ms-1" t-esc="label.month"/>
                        </button>
                        <button type="button" class="btn btn-secondary" t-if="state.data.can_print_roll" t-on-click="printRoll">
                            <i class="fa fa-print" role="img" aria-hidden="true"/>
                            <span class="ms-1" t-esc="label.roll"/>
                        </button>
                    </div>
                </header>

                <div class="o_ldm_panel o_ldm_empty" t-if="!state.data.days.length">
                    <i class="fa fa-calendar-check-o" role="img" aria-hidden="true"/>
                    <div>
                        <p class="o_ldm_empty_title" t-esc="label.empty"/>
                        <p t-esc="label.emptyHint"/>
                    </div>
                </div>

                <div class="o_ldm_panel o_ldm_ag_list" t-else="">
                    <section class="o_ldm_ag_day" t-foreach="state.data.days" t-as="day" t-key="day.date">
                        <t t-set="head" t-value="heading(day)"/>
                        <h2 class="o_ldm_ag_day_head">
                            <span t-esc="head.title"/>
                            <span class="o_ldm_md_hint" t-if="head.subtitle" t-esc="head.subtitle"/>
                            <span class="o_ldm_md_pill o_ldm_num" dir="ltr" t-esc="day.items.length"/>
                        </h2>
                        <ul class="o_ldm_ag_items">
                            <li t-foreach="day.items" t-as="item" t-key="item.key">
                                <button type="button" t-attf-class="o_ldm_ag_item o_ldm_ag_item_{{ item.kind }}"
                                        t-on-click="() => this.open(item)">
                                    <span class="o_ldm_ag_time o_ldm_num" dir="ltr" t-esc="hour(item.time)"/>
                                    <span class="o_ldm_ag_kind">
                                        <i t-attf-class="fa {{ kind(item).icon }}" role="img" t-att-title="kind(item).label"/>
                                        <span t-esc="kind(item).label"/>
                                    </span>
                                    <span class="o_ldm_ag_main">
                                        <span class="o_ldm_ag_label" t-esc="item.label"/>
                                        <span class="o_ldm_md_line">
                                            <span class="o_ldm_num" dir="ltr" t-if="item.number" t-esc="item.number"/>
                                            <span aria-hidden="true" t-if="item.number"> · </span>
                                            <span t-esc="item.subject"/>
                                        </span>
                                    </span>
                                    <span class="o_ldm_ag_who">
                                        <t t-if="item.who" t-esc="item.who"/>
                                        <span class="o_ldm_chip o_ldm_tone_warning" t-elif="item.unstaffed" t-esc="label.unstaffed"/>
                                    </span>
                                </button>
                            </li>
                        </ul>
                    </section>
                </div>
            </div>
        </Layout>
    </t>

</templates>
