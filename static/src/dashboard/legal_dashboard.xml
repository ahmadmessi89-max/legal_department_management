<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="legal_department_management.LegalDashboard">
        <div class="o_legal_dashboard p-4 overflow-auto h-100" dir="rtl">
            <!-- Clean, Elegant Executive Header (Without top dropdown filter) -->
            <div class="legal-hero-header d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="header-title mb-1">
                        <i class="fa fa-balance-scale text-primary me-2" title="العدالة"/>لوحة المتابعة والرقابة القانونية الذكية
                    </h2>
                    <p class="header-subtitle mb-0">متابعة شاملة للشركات الموكلة، القضايا، الجلسات القضائية، والموافقات التنفيذية</p>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button class="btn hero-btn-primary px-3 py-2 shadow-sm" t-on-click="createNewTask">
                        <i class="fa fa-plus-circle me-1"/> بدء معاملة جديدة
                    </button>
                    <button class="btn hero-btn-outline px-3 py-2 shadow-sm" t-on-click="openGeneralReport">
                        <i class="fa fa-print text-primary me-1"/> تقرير الرقابة الشامل
                    </button>
                </div>
            </div>

            <!-- Active Company Banner Indicator if filtered -->
            <t t-if="state.selectedCompanyId !== 0">
                <div class="alert alert-info d-flex justify-content-between align-items-center p-2 px-3 mb-4 rounded-3 shadow-sm" 
                     style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa fa-check-circle fs-5"/>
                        <span class="fw-bold">يتم حالياً عرض بيانات ومؤشرات شركة:</span>
                        <span class="badge bg-success px-2 py-1 fs-6"><t t-esc="state.selectedCompanyName"/></span>
                    </div>
                    <div>
                        <button class="btn btn-sm btn-outline-success fw-bold" t-on-click="() => this.selectCompany(0)">
                            <i class="fa fa-times me-1"/> إلغاء التصفية (عرض كافة الشركات)
                        </button>
                    </div>
                </div>
            </t>

            <!-- Loading Spinner -->
            <t t-if="state.isLoading">
                <div class="text-center py-5">
                    <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary"/>
                    <p class="mt-3 text-muted fw-bold">جاري تحميل بيانات الشؤون القانونية...</p>
                </div>
            </t>

            <!-- Dashboard Body -->
            <div t-else="" class="dashboard-content">
                <!-- Top 5 Interactive KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- KPI 1: Companies Card with Exclusive Dropdown Selector -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card kpi-blue">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div>
                                    <span class="text-muted small fw-bold d-block mb-1">الشركات الموكلة</span>
                                    <h3 class="fw-bolder mb-0 text-dark"><t t-esc="state.totalCompanies"/></h3>
                                </div>
                                <div class="kpi-icon-box bg-primary-subtle text-primary cursor-pointer" t-on-click="() => this.openCompaniesView()" title="عرض دليل الشركات">
                                    <i class="fa fa-building"/>
                                </div>
                            </div>
                            
                            <!-- Dropdown inside Company Card ONLY -->
                            <div class="mt-2 pt-2 border-top">
                                <label class="small text-muted fw-bold d-block mb-1" style="font-size: 0.75rem; color: #475569 !important;">اختر شركة لتصفية اللوحة:</label>
                                <select class="company-filter-select" 
                                        t-on-change="onCompanySelectChange">
                                    <option value="0" t-att-selected="state.selectedCompanyId === 0">🏢 كافة الشركات (الكل)</option>
                                    <t t-foreach="state.myCompanies" t-as="comp" t-key="comp.id">
                                        <option t-att-value="comp.id" t-att-selected="state.selectedCompanyId === comp.id">
                                            🏢 <t t-esc="comp.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 2: Active Tasks -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card kpi-purple cursor-pointer" t-on-click="() => this.openTasksView([['state', 'in', ['draft', 'in_progress', 'pending_docs']]])">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-bold d-block mb-1">القضايا الجارية</span>
                                    <h3 class="fw-bolder mb-0 text-dark"><t t-esc="state.inProgressTasks"/></h3>
                                    <span class="kpi-badge kpi-badge-info mt-2 small">
                                        <t t-if="state.selectedCompanyId !== 0">خاصة بالشركة 🎯</t>
                                        <t t-else="">قيد المتابعة</t>
                                    </span>
                                </div>
                                <div class="kpi-icon-box bg-info-subtle text-info">
                                    <i class="fa fa-gavel" title="القضايا الجارية"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 3: Pending Approvals -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card kpi-amber cursor-pointer" t-on-click="() => this.openPendingApprovals()">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-bold d-block mb-1">بانتظار الاعتماد</span>
                                    <h3 class="fw-bolder mb-0 text-dark"><t t-esc="state.pendingApprovalTasks"/></h3>
                                    <span class="kpi-badge kpi-badge-warning mt-2 small">
                                        <t t-if="state.selectedCompanyId !== 0">خاصة بالشركة ⏳</t>
                                        <t t-else="">موافقة المدير ⏳</t>
                                    </span>
                                </div>
                                <div class="kpi-icon-box bg-warning-subtle text-warning">
                                    <i class="fa fa-clock-o" title="الاعتماد"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 4: Urgent Tasks -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card kpi-rose cursor-pointer" t-on-click="() => this.openUrgentTasks()">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-bold d-block mb-1">قضايا عاجلة</span>
                                    <h3 class="fw-bolder mb-0 text-danger"><t t-esc="state.urgentTasks"/></h3>
                                    <span class="kpi-badge kpi-badge-danger mt-2 small">
                                        <t t-if="state.selectedCompanyId !== 0">عاجلة للشركة 🔥</t>
                                        <t t-else="">أولوية قصوى 🔥</t>
                                    </span>
                                </div>
                                <div class="kpi-icon-box bg-danger-subtle text-danger">
                                    <i class="fa fa-fire" title="عاجل"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 5: Completed Tasks -->
                    <div class="col-12 col-sm-6 col-xl">
                        <div class="kpi-card kpi-emerald cursor-pointer" t-on-click="() => this.openDoneTasks()">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="text-muted small fw-bold d-block mb-1">القضايا المنجزة</span>
                                    <h3 class="fw-bolder mb-0 text-success"><t t-esc="state.doneTasks"/></h3>
                                    <span class="kpi-badge kpi-badge-success mt-2 small">
                                        <t t-if="state.selectedCompanyId !== 0">منجزة للشركة ✓</t>
                                        <t t-else="">تم الحسم بنجاح ✓</t>
                                    </span>
                                </div>
                                <div class="kpi-icon-box bg-success-subtle text-success">
                                    <i class="fa fa-check-circle" title="منجزة"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Content Grid -->
                <div class="row g-4">
                    <!-- Left Column: Recent Tasks (7 cols) -->
                    <div class="col-12 col-lg-7">
                        <div class="dashboard-panel">
                            <div class="panel-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-list-alt text-primary fs-5" title="القضايا"/>
                                    <h5>
                                        أحدث المعاملات والقضايا المسجلة 
                                        <t t-if="state.selectedCompanyId !== 0">
                                            (<span class="text-primary"><t t-esc="state.selectedCompanyName"/></span>)
                                        </t>
                                    </h5>
                                </div>
                                <button class="btn btn-sm btn-outline-primary fw-bold" t-on-click="() => this.openTasksView()">
                                    عرض كافة القضايا (<t t-esc="state.totalTasks"/>)
                                </button>
                            </div>

                            <div class="task-list">
                                <t t-if="state.recentTasks.length === 0">
                                    <div class="text-center py-4 text-muted">
                                        <i class="fa fa-folder-open-o fa-2x mb-2" title="فارغ"/>
                                        <p class="mb-0">لا توجد قضايا مسجلة لهذه الشركة حالياً.</p>
                                    </div>
                                </t>
                                <t t-foreach="state.recentTasks" t-as="task" t-key="task.id">
                                    <div class="task-row-card cursor-pointer d-flex align-items-center justify-content-between flex-wrap gap-2"
                                         t-on-click="() => this.openTaskRecord(task.id)">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="text-center" style="min-width: 45px;">
                                                <span class="badge px-2 py-1" style="background-color: #f1f5f9; color: #1e293b; border: 1px solid #cbd5e1; font-weight: 700; font-family: monospace; font-size: 0.78rem;">
                                                    <t t-esc="task.task_number or '-'"/>
                                                </span>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark mb-1">
                                                    <t t-if="task.is_urgent">
                                                        <span class="badge badge-urgent me-1">عاجل 🔥</span>
                                                    </t>
                                                    <t t-esc="task.name"/>
                                                </div>
                                                <div class="text-muted small d-flex flex-wrap gap-3">
                                                    <span><i class="fa fa-building text-primary me-1" title="الشركة"/><t t-esc="task.legal_company_id ? task.legal_company_id[1] : 'عامة'"/></span>
                                                    <t t-if="task.department_id">
                                                        <span><i class="fa fa-university text-secondary me-1" title="الدائرة"/><t t-esc="task.department_id[1]"/></span>
                                                    </t>
                                                    <t t-if="task.session_date">
                                                        <span class="text-danger fw-bold"><i class="fa fa-calendar me-1" title="الجلسة"/>جلسة: <t t-esc="task.session_date"/></span>
                                                    </t>
                                                </div>
                                            </div>
                                        </div>
                                        <div>
                                            <t t-if="task.state === 'done'">
                                                <span class="badge badge-done">منجزة ✓</span>
                                            </t>
                                            <t t-elif="task.state === 'pending_docs'">
                                                <span class="badge badge-pending">بانتظار وثائق ⏳</span>
                                            </t>
                                            <t t-elif="task.state === 'in_progress'">
                                                <span class="badge badge-progress">قيد الإجراء ⚙️</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge bg-secondary-subtle text-secondary">مسودة 📝</span>
                                            </t>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Upcoming Sessions & Top Departments (5 cols) -->
                    <div class="col-12 col-lg-5">
                        <!-- Upcoming Court Sessions -->
                        <div class="dashboard-panel mb-4">
                            <div class="panel-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-calendar-check-o text-danger fs-5" title="الجلسات"/>
                                    <h5>
                                        الجلسات القضائية القادمة 
                                        <t t-if="state.selectedCompanyId !== 0">
                                            (<span class="text-danger"><t t-esc="state.selectedCompanyName"/></span>)
                                        </t>
                                    </h5>
                                </div>
                            </div>

                            <t t-if="state.upcomingSessions.length === 0">
                                <div class="text-center py-3 text-muted">
                                    <i class="fa fa-check-circle-o text-success fa-2x mb-1" title="مكتمل"/>
                                    <p class="small mb-0">لا توجد جلسات قضائية قادمة لهذه الشركة.</p>
                                </div>
                            </t>
                            <t t-foreach="state.upcomingSessions" t-as="session" t-key="session.id">
                                <div class="task-row-card cursor-pointer d-flex align-items-center justify-content-between mb-2"
                                     style="border-right: 4px solid #ef4444;"
                                     t-on-click="() => this.openTaskRecord(session.id)">
                                    <div>
                                        <div class="fw-bold text-dark small mb-1"><t t-esc="session.name"/></div>
                                        <div class="text-muted small"><i class="fa fa-building me-1" title="الشركة"/><t t-esc="session.legal_company_id ? session.legal_company_id[1] : '-'"/></div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-danger text-white fw-bold"><i class="fa fa-clock-o me-1" title="الموعد"/><t t-esc="session.session_date"/></span>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Top Official Departments -->
                        <div class="dashboard-panel">
                            <div class="panel-header">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-university text-warning fs-5" title="الدوائر"/>
                                    <h5>
                                        توزيع القضايا حسب الدوائر الرسمية 
                                        <t t-if="state.selectedCompanyId !== 0">
                                            (<span class="text-primary"><t t-esc="state.selectedCompanyName"/></span>)
                                        </t>
                                    </h5>
                                </div>
                            </div>

                            <t t-if="state.topDepartments.length === 0">
                                <div class="text-center py-3 text-muted">
                                    <p class="small mb-0">لم يتم تحديد دوائر رسمية لهذه الشركة بعد.</p>
                                </div>
                            </t>
                            <t t-foreach="state.topDepartments" t-as="dept" t-key="dept.name">
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="fw-bold small text-dark"><t t-esc="dept.name"/></span>
                                        <span class="kpi-badge kpi-badge-blue fw-bold py-1"><t t-esc="dept.count"/> معاملة</span>
                                    </div>
                                    <div class="progress" style="height: 7px;">
                                        <div class="progress-bar bg-primary rounded-pill" role="progressbar" 
                                             t-att-style="'width: ' + dept.percentage + '%;'" 
                                             t-att-aria-valuenow="dept.percentage" aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
