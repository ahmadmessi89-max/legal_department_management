<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A palette row for a matter, client or body: what it is, its number,
         and where it stands. The number is pinned left-to-right so the bidi
         algorithm cannot reorder CASE/2026/09/007. -->
    <t t-name="legal_department_management.CommandItem">
        <div class="o_command_default o_ldm_command d-flex align-items-center gap-2 px-4 py-2 cursor-pointer">
            <LdmIcon name="props.icon || 'folder-open'" class="'text-muted'"/>
            <div class="d-flex flex-column flex-grow-1 overflow-hidden">
                <span class="text-truncate">
                    <span class="o_ldm_command_number me-2 text-muted o_ldm_num" dir="ltr" t-if="props.number" t-esc="props.number"/>
                    <span dir="auto" class="fw-bold" t-esc="props.title"/>
                </span>
                <small class="text-muted text-truncate" t-if="props.line || props.matched">
                    <t t-esc="props.line"/>
                    <t t-if="props.line &amp;&amp; props.matched"> · </t>
                    <t t-esc="props.matched"/>
                </small>
            </div>
            <t t-slot="focusMessage"/>
        </div>
    </t>

</templates>
