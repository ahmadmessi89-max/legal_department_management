<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_department_management.LdmTimerSystray">
        <t t-if="state.enabled">
            <Dropdown position="'bottom-end'" beforeOpen.bind="onBeforeOpen" menuClass="'o_ldm o_ldm_timer_menu p-2'"
                      state="dropdown">
                <button class="o_ldm_timer_toggle d-flex align-items-center gap-1"
                        t-att-class="{ 'o_ldm_timer_running': state.running }"
                        t-att-title="toggleTitle">
                    <i class="fa fa-clock-o" role="img" aria-label="Timer" title="Timer"/>
                    <span t-if="state.running" class="o_ldm_timer_clock" t-out="elapsedLabel"/>
                </button>
                <t t-set-slot="content">
                    <div class="o_ldm_timer_panel d-flex flex-column gap-2">
                        <t t-if="state.running">
                            <div class="small text-muted">Running on</div>
                            <a href="#" class="fw-bold text-truncate" t-on-click.prevent="openRunningMatter"
                               t-out="state.taskName"/>
                            <div class="o_ldm_timer_big" t-out="elapsedLabel"/>
                            <button class="btn btn-primary" t-on-click="stop">
                                <i class="fa fa-stop me-1" role="img" aria-label="Stop" title="Stop"/>Stop and record
                            </button>
                        </t>
                        <t t-else="">
                            <button t-if="openMatterId" class="btn btn-primary" t-on-click="startHere">
                                <i class="fa fa-play me-1" role="img" aria-label="Start" title="Start"/>Start on this matter
                            </button>
                            <div t-else="" class="small text-muted">Open a matter to time it, or pick one:</div>
                            <t t-if="state.recent.length">
                                <div t-if="openMatterId" class="small text-muted mt-1">Or one of your matters:</div>
                                <DropdownItem t-foreach="state.recent" t-as="matter" t-key="matter.id"
                                              class="'o_ldm_timer_matter text-truncate'"
                                              onSelected="() => this.start(matter.id)">
                                    <div class="text-truncate" t-out="matter.name"/>
                                    <div class="small text-muted text-truncate" t-out="matter.client"/>
                                </DropdownItem>
                            </t>
                            <div t-elif="!openMatterId" class="small text-muted">You have no open matters.</div>
                        </t>
                    </div>
                </t>
            </Dropdown>
        </t>
    </t>

    <t t-name="legal_department_management.LdmTimerStopDialog">
        <Dialog title.translate="Record the time" size="'md'">
            <div class="o_ldm o_ldm_timer_dialog d-flex flex-column gap-3" t-on-keydown="onKeydown">
                <div class="text-muted text-truncate" t-out="props.taskName"/>
                <div>
                    <label class="form-label fw-bold" for="ldm_timer_description">What was done</label>
                    <input id="ldm_timer_description" type="text" class="form-control" autofocus="autofocus"
                           t-model="state.description" placeholder="e.g. Drafted the reply to the appeal"/>
                </div>
                <div class="d-flex flex-wrap gap-4 align-items-end">
                    <div>
                        <label class="form-label fw-bold" for="ldm_timer_duration">Time</label>
                        <input id="ldm_timer_duration" type="text" class="form-control o_ldm_timer_duration"
                               t-model="state.duration" inputmode="decimal"/>
                    </div>
                    <div class="form-check mb-2">
                        <input id="ldm_timer_billable" type="checkbox" class="form-check-input" t-model="state.billable"/>
                        <label class="form-check-label" for="ldm_timer_billable">Billable</label>
                    </div>
                </div>
                <div t-if="state.error" class="text-danger" role="alert" t-out="state.error"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-att-disabled="state.saving" t-on-click="save">Record</button>
                <button class="btn btn-secondary" t-on-click="discard">Discard the time</button>
            </t>
        </Dialog>
    </t>

</templates>
