<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="legal_department_management.ClientNow">
        <section class="o_ldm o_ldm_panel o_ldm_now" t-if="props.record.resId">
            <header class="o_ldm_dossier_head">
                <h3 class="o_ldm_section_title" t-esc="dossier.labels ? dossier.labels.now : ''"/>
                <button type="button" class="o_ldm_linkbtn" t-if="rows.length" t-on-click="openAll" t-esc="label.all"/>
            </header>
            <div class="o_ldm_empty" t-if="!rows.length">
                <i class="fa fa-check-circle" role="img" aria-hidden="true"/>
                <div>
                    <p class="o_ldm_empty_title" t-esc="label.empty"/>
                    <p t-esc="label.emptyHint"/>
                </div>
            </div>
            <ul class="o_ldm_now_rows" t-else="">
                <li t-foreach="rows" t-as="row" t-key="row.id">
                    <button type="button" t-attf-class="o_ldm_now_row {{ row.urgent ? 'o_ldm_now_urgent' : '' }}"
                            t-on-click="() => this.open(row)">
                        <span class="o_ldm_now_main">
                            <span class="o_ldm_now_title">
                                <i class="fa fa-flag o_ldm_text_danger" t-if="row.urgent" role="img" title="Urgent"/>
                                <t t-esc="row.title"/>
                            </span>
                            <span class="o_ldm_now_meta">
                                <span class="o_ldm_num" dir="ltr" t-esc="row.number"/>
                                <t t-if="row.next_action"> · <t t-esc="row.next_action"/></t>
                            </span>
                        </span>
                        <span t-attf-class="o_ldm_now_when {{ row.tone ? 'o_ldm_text_' + row.tone : '' }}" t-esc="row.when"/>
                    </button>
                </li>
            </ul>
        </section>
    </t>

    <t t-name="legal_department_management.BodyWindows">
        <section class="o_ldm o_ldm_panel o_ldm_bodies" t-if="props.record.resId">
            <header class="o_ldm_dossier_head">
                <h3 class="o_ldm_section_title" t-esc="dossier.labels ? dossier.labels.bodies : ''"/>
            </header>
            <p class="o_ldm_bodies_empty" t-if="!bodies.length" t-esc="label.empty"/>
            <div class="o_ldm_bodies_grid" t-else="">
                <button type="button" t-foreach="bodies" t-as="body" t-key="body.id"
                        class="o_ldm_body_card" t-att-data-body-id="body.id" t-on-click="() => this.open(body)">
                    <span class="o_ldm_body_name">
                        <i t-attf-class="fa {{ body.kind === 'court' ? 'fa-gavel' : 'fa-building-o' }}" role="img" aria-hidden="true"/>
                        <t t-esc="body.name"/>
                    </span>
                    <span class="o_ldm_body_ministry" t-if="body.ministry" t-esc="body.ministry"/>
                    <span class="o_ldm_body_counts">
                        <span class="o_ldm_chip o_ldm_tone_info" t-if="body.openLabel" t-esc="body.openLabel"/>
                        <span class="o_ldm_chip" t-if="body.doneLabel" t-esc="body.doneLabel"/>
                    </span>
                    <span t-attf-class="o_ldm_body_next {{ body.tone ? 'o_ldm_text_' + body.tone : '' }}"
                          t-if="body.nextLabel" t-esc="body.nextLabel"/>
                </button>
            </div>
        </section>
    </t>

</templates>
