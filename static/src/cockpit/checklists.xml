<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ===================================================== step checklist -->
    <t t-name="legal_department_management.StepChecklist">
        <section class="o_ldm o_ldm_checklist o_ldm_steps">
            <header class="o_ldm_checklist_head" t-if="rows.length">
                <span class="o_ldm_checklist_meter o_ldm_num" dir="ltr">
                    <t t-esc="progress.done"/> / <t t-esc="progress.total"/>
                </span>
                <progress class="o_ldm_checklist_bar" t-att-value="progress.done" t-att-max="progress.total || 1"
                          t-att-aria-label="label.title"/>
            </header>

            <div class="o_ldm_empty" t-if="!rows.length">
                <LdmIcon name="'list-checks'"/>
                <div>
                    <p class="o_ldm_empty_title" t-esc="label.empty"/>
                    <p t-esc="label.emptyHint"/>
                </div>
            </div>

            <ul class="o_ldm_checklist_rows" t-else="">
                <li t-foreach="rows" t-as="row" t-key="row.id"
                    t-attf-class="o_ldm_check_row {{ row.done ? 'o_ldm_check_done' : '' }} {{ row.skipped ? 'o_ldm_check_skipped' : '' }}"
                    t-att-data-state="row.state" t-att-data-step-id="row.id">
                    <!-- The whole row is the target: one click ticks the step. -->
                    <button type="button" class="o_ldm_check_target" role="checkbox"
                            t-att-aria-checked="row.done ? 'true' : 'false'"
                            t-att-disabled="(!canEdit || row.skipped || state.busy[row.id]) ? 'disabled' : undefined"
                            t-att-title="rowTitle(row)"
                            t-on-click="() => this.toggle(row)">
                        <span class="o_ldm_check_box" aria-hidden="true">
                            <LdmIcon t-if="row.done" name="'check'"/>
                            <LdmIcon t-elif="row.skipped" name="'minus'"/>
                        </span>
                        <span class="o_ldm_check_main">
                            <span class="o_ldm_check_name" t-esc="row.name"/>
                            <span class="o_ldm_check_meta">
                                <span class="o_ldm_pill o_ldm_tone_info" t-if="row.visit">
                                    <LdmIcon name="'building-2'"/>
                                    <t t-esc="label.visitChip"/><t t-if="row.body"> · <t t-esc="row.body"/></t>
                                </span>
                                <span t-if="row.done">
                                    <t t-esc="label.done"/><t t-if="row.doneOn"> · <t t-esc="row.doneOn"/></t><t t-if="row.doneBy"> · <t t-esc="row.doneBy"/></t>
                                </span>
                                <span t-elif="row.skipped" t-esc="label.skipped"/>
                                <t t-else="">
                                    <span t-if="row.due" t-attf-class="{{ row.tone ? 'o_ldm_text_' + row.tone : '' }}">
                                        <t t-esc="row.due"/> · <t t-esc="row.dueLabel"/>
                                    </span>
                                    <span t-if="row.user"><LdmIcon name="'user'"/> <t t-esc="row.user"/></span>
                                </t>
                                <span class="o_ldm_check_note" t-if="row.note" t-esc="row.note"/>
                            </span>
                        </span>
                    </button>
                    <div class="o_ldm_check_tools">
                        <button type="button" class="o_ldm_action" t-if="row.visit &amp;&amp; !row.done &amp;&amp; !row.skipped &amp;&amp; canEdit"
                                t-on-click="(ev) => this.logVisit(row, ev)">
                            <LdmIcon name="'pencil'"/>
                            <span t-esc="label.visit"/>
                        </button>
                        <button type="button" class="o_ldm_iconbtn" t-if="canEdit" t-att-title="label.edit"
                                t-att-aria-label="label.edit" t-on-click="(ev) => this.edit(row, ev)">
                            <LdmIcon name="'pencil'"/>
                        </button>
                    </div>
                </li>
            </ul>

            <footer class="o_ldm_checklist_foot" t-if="canEdit">
                <button type="button" class="o_ldm_linkbtn" t-on-click="add">
                    <LdmIcon name="'plus'"/>
                    <span t-esc="label.add"/>
                </button>
            </footer>
        </section>
    </t>

    <!-- ================================================= document checklist -->
    <t t-name="legal_department_management.DocumentChecklist">
        <section class="o_ldm o_ldm_checklist o_ldm_documents" t-ref="root">
            <header class="o_ldm_checklist_head" t-if="rows.length">
                <span class="o_ldm_checklist_meter o_ldm_num" dir="ltr">
                    <t t-esc="meter.have"/> / <t t-esc="meter.total"/>
                </span>
                <progress class="o_ldm_checklist_bar" t-att-value="meter.have" t-att-max="meter.total || 1"
                          t-att-aria-label="label.title"/>
                <span class="o_ldm_spinner" t-if="state.busy" role="status" aria-hidden="true"/>
            </header>

            <div class="o_ldm_empty" t-if="!rows.length">
                <LdmIcon name="'folder-open'"/>
                <div>
                    <p class="o_ldm_empty_title" t-esc="label.empty"/>
                    <p t-esc="label.emptyHint"/>
                </div>
            </div>

            <ul class="o_ldm_checklist_rows" t-else="">
                <li t-foreach="rows" t-as="row" t-key="row.id"
                    t-attf-class="o_ldm_doc_row {{ state.over === row.id ? 'o_ldm_doc_over' : '' }} {{ row.missing ? 'o_ldm_doc_missing' : '' }}"
                    t-att-data-state="row.state" t-att-data-document-id="row.id"
                    t-on-dragover="(ev) => this.onRowDragOver(row, ev)"
                    t-on-dragleave="() => this.onRowDragLeave(row)"
                    t-on-drop="(ev) => this.onRowDrop(row, ev)">
                    <span t-attf-class="o_ldm_doc_icon o_ldm_text_{{ row.tone || 'muted' }}" aria-hidden="true">
                        <LdmIcon name="row.icon"/>
                    </span>
                    <span class="o_ldm_doc_main">
                        <span class="o_ldm_doc_name">
                            <t t-esc="row.name"/>
                            <span class="o_ldm_doc_required" t-if="row.mandatory" t-att-title="label.mandatory">*</span>
                        </span>
                        <span class="o_ldm_check_meta">
                            <span t-if="row.state === 'verified'" class="o_ldm_stamp">
                                <LdmIcon name="'stamp'"/>
                                <t t-esc="label.genuine"/>
                            </span>
                            <span t-else="" t-attf-class="o_ldm_pill {{ row.tone ? 'o_ldm_tone_' + row.tone : '' }}" t-esc="row.stateLabel"/>
                            <span t-if="row.expiry" t-esc="row.expiry"/>
                            <span class="o_ldm_check_note" t-if="row.note" t-esc="row.note"/>
                            <span class="o_ldm_doc_drophint" t-if="state.over === row.id" t-esc="label.drop"/>
                        </span>
                    </span>
                    <span class="o_ldm_check_tools">
                        <button type="button" class="o_ldm_action" t-if="row.attachment" t-on-click="(ev) => this.view(row, ev)"
                                t-att-title="label.view">
                            <LdmIcon name="'file-text'"/>
                            <span class="o_ldm_doc_file" t-esc="row.attachment.display_name"/>
                        </button>
                        <t t-if="canEdit">
                            <input type="file" class="d-none o_ldm_input_file" accept="image/*,application/pdf"
                                   t-on-change="(ev) => this.onInputChange(row, ev)"/>
                            <input type="file" class="d-none o_ldm_input_camera" accept="image/*" capture="environment"
                                   t-on-change="(ev) => this.onInputChange(row, ev)"/>
                            <button type="button" class="o_ldm_iconbtn" data-input="o_ldm_input_file"
                                    t-att-title="label.upload" t-att-aria-label="label.upload" t-on-click="pick">
                                <LdmIcon name="'upload'"/>
                            </button>
                            <button type="button" class="o_ldm_iconbtn" data-input="o_ldm_input_camera"
                                    t-att-title="label.camera" t-att-aria-label="label.camera" t-on-click="pick">
                                <LdmIcon name="'camera'"/>
                            </button>
                        </t>
                    </span>
                </li>
            </ul>
        </section>
    </t>

</templates>
