<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- A row of My Day: the kind spine on its start edge, the title, where it
         belongs, why it is here and what else is wrong, then the time left and
         its one action. -->
    <t t-name="legal_department_management.MyDayRow">
        <div t-att-class="rowClass(row)" tabindex="0" role="link" t-att-data-kind="row.kind"
             t-on-click="() => this.openRow(row)" t-on-keydown="(ev) => this.onRowKeydown(row, ev)">
            <div class="o_ldm_row_main">
                <div class="o_ldm_row_title">
                    <LdmIcon t-if="row.confidential" name="'lock'" title="label.confidential" class="'o_ldm_text_muted'"/>
                    <span dir="auto" class="o_ldm_row_title_text" t-esc="row.subject"/>
                </div>
                <div class="o_ldm_row_line">
                    <span class="o_ldm_ref" dir="ltr" t-if="row.number" t-esc="row.number"/>
                    <span dir="auto" class="o_ldm_row_where" t-if="row.line" t-esc="row.line"/>
                    <span class="o_ldm_row_who" t-if="state.scope !== 'me' &amp;&amp; row.who">
                        <LdmIcon name="'user'" title="label.responsible"/>
                        <t t-esc="row.who"/>
                    </span>
                </div>
                <div class="o_ldm_row_reason">
                    <LdmIcon name="kindIcon(row.kind)" title="kindLabel(row.kind)" class="'o_ldm_row_kind_icon'"/>
                    <span t-if="showKind(row)" class="o_ldm_row_kind" t-esc="kindLabel(row.kind)"/>
                    <span dir="auto" t-esc="row.reason"/>
                </div>
                <div class="o_ldm_flags o_ldm_row_flags" t-if="row.flags &amp;&amp; row.flags.length">
                    <span t-foreach="row.flags" t-as="flag" t-key="flag.key"
                          t-attf-class="o_ldm_pill o_ldm_tone_{{ flag.tone }}" t-att-data-flag="flag.key">
                        <LdmIcon name="flag.icon"/>
                        <t t-esc="flag.label"/>
                    </span>
                </div>
            </div>
            <div class="o_ldm_row_side">
                <t t-set="when" t-value="rowDate(row)"/>
                <span t-if="when.label" dir="auto" t-attf-class="o_ldm_pill o_ldm_row_when {{ when.tone ? 'o_ldm_tone_' + when.tone : '' }}"
                      t-esc="when.label"/>
                <t t-if="row.action">
                    <div class="o_ldm_row_date_input" t-if="row.action.type === 'notified'" t-on-click.stop="() => {}">
                        <DateTimeInput type="'date'" maxDate="'today'" placeholder="label.notifiedOn.toString()"
                                       onChange="(value) => this.onDateChange(row, value)"/>
                    </div>
                    <button type="button" class="o_ldm_action"
                            t-att-disabled="state.pending[row.key] ? 'disabled' : undefined"
                            t-on-click="(ev) => this.runAction(row, ev)">
                        <LdmIcon t-if="row.action.type === 'tick'" name="'check'"/>
                        <span t-esc="row.action.label"/>
                    </button>
                </t>
            </div>
        </div>
    </t>

    <t t-name="legal_department_management.MyDay">
        <Layout className="'o_ldm o_ldm_my_day_screen'" display="{}">
            <div class="o_ldm_state" t-if="!data &amp;&amp; !state.error" role="status">
                <span class="o_ldm_spinner" aria-hidden="true"/>
                <span t-esc="label.loading"/>
            </div>

            <div class="o_ldm_state o_ldm_state_error" t-if="!data &amp;&amp; state.error" role="alert">
                <LdmIcon name="'circle-alert'" size="'xl'" title="label.errorTitle"/>
                <div>
                    <p class="o_ldm_state_title" t-esc="label.errorTitle"/>
                    <p class="o_ldm_state_hint" t-esc="label.errorHint"/>
                    <button type="button" class="o_ldm_action o_ldm_action_primary" t-on-click="() => this.load()" t-esc="label.retry"/>
                </div>
            </div>

            <div class="o_ldm_my_day" t-if="data" t-att-data-role="data.header.role" t-att-data-scope="data.scope">
                <!-- ====================================================== the band -->
                <!-- Who and when, the search, and (for a manager) whose work. -->
                <header class="o_ldm_band o_ldm_md_band">
                    <div class="o_ldm_md_id">
                        <h1 class="o_ldm_band_title" t-esc="dateLine"/>
                        <p class="o_ldm_band_meta">
                            <span class="o_ldm_md_hijri" t-if="hijriLine" t-esc="hijriLine"/>
                            <span class="o_ldm_band_sep o_ldm_md_hijri" t-if="hijriLine" aria-hidden="true">·</span>
                            <span dir="auto" class="o_ldm_md_summary" t-esc="summary"/>
                            <span class="o_ldm_band_sep" aria-hidden="true">·</span>
                            <span t-esc="data.header.role_label"/>
                            <span class="o_ldm_pill o_ldm_pill_on_ink" t-if="data.read_only and data.work" t-esc="label.readOnly"/>
                        </p>
                    </div>
                    <div class="o_ldm_md_band_tools">
                        <button type="button" class="o_ldm_band_ghost o_ldm_md_search" t-on-click="openSearch"
                                t-att-aria-label="label.search">
                            <LdmIcon name="'search'"/>
                            <span dir="auto" class="o_ldm_md_search_text" t-esc="label.search"/>
                            <kbd class="o_ldm_md_kbd">Ctrl K</kbd>
                        </button>
                        <div class="o_ldm_segmented o_ldm_segmented_on_ink o_ldm_md_scopes" t-if="data.scopes.length"
                             role="tablist" t-att-aria-label="label.scopes">
                            <button type="button" role="tab" t-foreach="data.scopes" t-as="scope" t-key="scope.key"
                                    t-att-class="{'o_ldm_md_scope': true, 'o_ldm_md_scope_on': scope.key === state.scope}"
                                    t-att-aria-selected="scope.key === state.scope ? 'true' : 'false'"
                                    t-on-click="() => this.setScope(scope.key)" t-esc="scope.label"/>
                        </div>
                    </div>
                </header>

                <div class="o_ldm_md_desk">
                    <!-- What this role starts from: verbs first, then the places it
                         goes to most. The first is the screen's one primary action. -->
                    <nav class="o_ldm_md_actions" t-if="data.actions.length" t-att-aria-label="label.actions">
                        <button type="button" t-foreach="data.actions" t-as="act" t-key="act.key"
                                t-attf-class="o_ldm_md_act {{ act.primary ? 'o_ldm_md_act_primary' : '' }}"
                                t-att-data-action="act.key" t-att-title="act.key === 'new_matter' ? 'Alt+Shift+N' : undefined"
                                t-on-click="() => this.openTarget(act.target)">
                            <span class="o_ldm_md_act_icon"><LdmIcon name="act.icon"/></span>
                            <span class="o_ldm_md_act_text">
                                <span class="o_ldm_md_act_label" t-esc="act.label"/>
                                <span class="o_ldm_md_act_hint" t-if="act.hint" t-esc="act.hint"/>
                            </span>
                            <span class="o_ldm_md_act_count o_ldm_num" dir="ltr" t-if="act.count" t-esc="act.count"/>
                            <LdmIcon name="'arrow-up-right'" class="'o_ldm_md_act_go'"/>
                        </button>
                    </nav>

                    <!-- The counts this role watches. Each opens exactly what it
                         counted: a band of the list below, or the records. -->
                    <section class="o_ldm_md_tiles" t-if="data.tiles.length" t-att-aria-label="label.tiles">
                        <button type="button" t-foreach="data.tiles" t-as="tile" t-key="tile.key"
                                t-attf-class="o_ldm_md_tile o_ldm_md_tile_{{ tile.tone }} {{ tileEmpty(tile) ? 'o_ldm_md_tile_zero' : '' }} {{ tile.amount !== undefined ? 'o_ldm_md_tile_money' : '' }}"
                                t-att-data-tile="tile.key" t-att-disabled="tileDisabled(tile) ? 'disabled' : undefined"
                                t-on-click="() => this.openTarget(tile.target)">
                            <span class="o_ldm_md_tile_head">
                                <LdmIcon name="tile.icon"/>
                                <span class="o_ldm_md_tile_label" t-esc="tile.label"/>
                            </span>
                            <span class="o_ldm_md_tile_n o_ldm_num" dir="ltr" t-esc="tileValue(tile)"/>
                            <span class="o_ldm_md_tile_hint" t-if="tile.hint" t-esc="tile.hint"/>
                        </button>
                    </section>

                    <!-- Where the open work is (those who oversee): each bar opens its matters. -->
                    <section class="o_ldm_md_glance" t-if="data.glance.length" t-att-aria-label="label.glance">
                        <div class="o_ldm_panel o_ldm_md_glance_panel" t-foreach="data.glance" t-as="panel"
                             t-key="panel.key" t-att-data-glance="panel.key">
                            <div class="o_ldm_panel_head">
                                <h2 class="o_ldm_section_title" t-esc="panel.title"/>
                                <span class="o_ldm_md_legend" t-if="panel.legend">
                                    <span class="o_ldm_md_legend_key" aria-hidden="true"/>
                                    <t t-esc="panel.legend"/>
                                </span>
                            </div>
                            <ul class="o_ldm_md_bars">
                                <li t-foreach="panel.rows" t-as="bar" t-key="bar.key">
                                    <button type="button" class="o_ldm_md_bar" t-on-click="() => this.openGlance(panel, bar)"
                                            t-att-title="bar.label">
                                        <span dir="auto" class="o_ldm_md_bar_label" t-esc="bar.label"/>
                                        <span class="o_ldm_md_bar_track" aria-hidden="true">
                                            <span class="o_ldm_md_bar_fill" t-attf-style="inline-size: {{ bar.share }}%"/>
                                            <span class="o_ldm_md_bar_late" t-if="bar.late"
                                                  t-attf-style="inline-size: {{ lateShare(bar) }}%"/>
                                        </span>
                                        <span class="o_ldm_md_bar_n o_ldm_num" dir="ltr">
                                            <t t-esc="bar.count"/>
                                            <span class="o_ldm_md_bar_late_n" t-if="bar.late"> · <t t-esc="bar.late"/></span>
                                        </span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </section>

                    <div class="o_ldm_md_main">
                        <!-- ================================================ the queue -->
                        <section class="o_ldm_md_queue" t-ref="queue" t-on-keydown="onQueueKeydown">
                            <!-- The runner's route: today's counters, and what to carry. -->
                            <div class="o_ldm_panel o_ldm_md_route" t-if="data.by_body.length" t-ref="route">
                                <div class="o_ldm_panel_head">
                                    <h2 class="o_ldm_section_title" t-esc="label.routeTitle"/>
                                    <span dir="auto" class="o_ldm_md_hint" t-esc="label.routeHint"/>
                                </div>
                                <div class="o_ldm_md_body" t-foreach="data.by_body" t-as="group" t-key="group.key">
                                    <div class="o_ldm_md_body_head">
                                        <LdmIcon name="'building-2'"/>
                                        <span class="o_ldm_md_body_name" t-esc="group.body"/>
                                        <span class="o_ldm_md_hint" t-if="group.hours">
                                            <LdmIcon name="'clock'"/> <t t-esc="group.hours"/>
                                        </span>
                                        <span class="o_ldm_md_hint" t-if="group.address">
                                            <LdmIcon name="'map-pin'"/> <t t-esc="group.address"/>
                                        </span>
                                    </div>
                                    <div class="o_ldm_md_visit" t-foreach="group.visits" t-as="visit" t-key="visit.step_id">
                                        <button type="button" class="o_ldm_md_visit_main" t-on-click="() => this.openMatter(visit.task_id)">
                                            <span dir="auto" class="o_ldm_md_visit_subject" t-esc="visit.subject"/>
                                            <span class="o_ldm_row_line">
                                                <span class="o_ldm_ref" dir="ltr" t-esc="visit.number"/>
                                                <span t-esc="visit.step"/>
                                            </span>
                                        </button>
                                        <button type="button" class="o_ldm_action o_ldm_action_primary" t-if="!data.read_only"
                                                t-on-click="(ev) => this.logVisit(visit, ev)">
                                            <LdmIcon name="'pencil'"/>
                                            <span t-esc="label.logVisit"/>
                                        </button>
                                        <div class="o_ldm_md_docs" t-if="visit.documents.length">
                                            <span t-foreach="visit.documents" t-as="doc" t-key="doc_index"
                                                  t-attf-class="o_ldm_pill {{ doc.have ? 'o_ldm_tone_success' : (doc.state === 'expired' ? 'o_ldm_tone_danger' : 'o_ldm_tone_warning') }}"
                                                  t-att-title="doc.state_label">
                                                <LdmIcon name="doc.have ? 'check' : 'circle-alert'" title="doc.have ? label.have : label.missing"/>
                                                <t t-esc="doc.name"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="o_ldm_panel o_ldm_empty o_ldm_md_clear" t-if="data.all_clear">
                                <LdmIcon name="'circle-check'"/>
                                <div>
                                    <p class="o_ldm_empty_title" t-esc="data.all_clear.title"/>
                                    <p t-esc="data.all_clear.hint"/>
                                    <p class="mt-3" t-if="data.can_create">
                                        <button type="button" class="o_ldm_action o_ldm_action_primary" t-on-click="newMatter">
                                            <LdmIcon name="'plus'"/>
                                            <span t-esc="label.newMatter"/>
                                        </button>
                                    </p>
                                </div>
                            </div>

                            <div class="o_ldm_panel o_ldm_md_bands" t-if="visibleBands.length">
                                <section class="o_ldm_md_band_section" t-foreach="visibleBands" t-as="band" t-key="band.key"
                                         t-att-data-band="band.key">
                                    <button type="button" t-attf-class="o_ldm_md_band_head o_ldm_md_band_{{ band.key }}"
                                            t-att-aria-expanded="isFolded(band) ? 'false' : 'true'"
                                            t-on-click="() => this.toggleBand(band)">
                                        <span class="o_ldm_md_band_dot" aria-hidden="true"/>
                                        <span class="o_ldm_md_band_title" t-esc="band.title"/>
                                        <span class="o_ldm_pill o_ldm_num" dir="ltr" t-esc="band.count"/>
                                        <LdmIcon name="isFolded(band) ? 'chevron-down' : 'chevron-up'"
                                                 title="isFolded(band) ? label.unfold : label.fold" class="'o_ldm_md_band_caret'"/>
                                    </button>
                                    <ul class="o_ldm_md_rows" t-if="!isFolded(band)">
                                        <li t-foreach="band.rows" t-as="row" t-key="row.key">
                                            <t t-call="legal_department_management.MyDayRow"/>
                                        </li>
                                    </ul>
                                    <p class="o_ldm_md_more" t-if="!isFolded(band) &amp;&amp; band.truncated" t-esc="moreLabel(band)"/>
                                </section>
                            </div>

                            <!-- Items that need a manager rather than their owner. -->
                            <div class="o_ldm_panel o_ldm_md_manager" t-if="data.manager.length">
                                <div class="o_ldm_panel_head">
                                    <h2 class="o_ldm_section_title" t-esc="label.managerTitle"/>
                                </div>
                                <section class="o_ldm_md_band_section" t-foreach="data.manager" t-as="band" t-key="band.key"
                                         t-att-data-band="band.key">
                                    <div class="o_ldm_md_band_head o_ldm_md_band_static">
                                        <span class="o_ldm_md_band_title" t-esc="band.title"/>
                                        <span class="o_ldm_pill o_ldm_num" dir="ltr" t-esc="band.rows.length"/>
                                    </div>
                                    <ul class="o_ldm_md_rows">
                                        <li t-foreach="band.rows" t-as="row" t-key="row.key">
                                            <t t-call="legal_department_management.MyDayRow"/>
                                        </li>
                                    </ul>
                                </section>
                            </div>
                        </section>

                        <!-- ====================================== the next seven days -->
                        <aside class="o_ldm_md_side">
                            <button type="button" class="o_ldm_panel o_ldm_md_advance" t-foreach="data.advance"
                                    t-as="entry" t-key="entry_index" t-on-click="openAdvances">
                                <span class="o_ldm_md_hint">
                                    <LdmIcon name="'wallet'"/> <t t-esc="entry.label"/>
                                </span>
                                <span class="o_ldm_md_advance_amount o_ldm_num" dir="ltr" t-esc="amount(entry)"/>
                            </button>
                            <section class="o_ldm_panel o_ldm_md_agenda" t-if="data.agenda">
                                <div class="o_ldm_panel_head">
                                    <h2 class="o_ldm_section_title" t-esc="data.agenda.title"/>
                                </div>
                                <p class="o_ldm_md_agenda_empty" t-if="!data.agenda.days.length" t-esc="data.agenda.empty"/>
                                <div class="o_ldm_md_day" t-foreach="data.agenda.days" t-as="day" t-key="day.date">
                                    <t t-set="heading" t-value="agendaDay(day)"/>
                                    <h3 class="o_ldm_md_day_head">
                                        <span t-esc="heading.title"/>
                                        <span class="o_ldm_md_hint" t-if="heading.subtitle" t-esc="heading.subtitle"/>
                                    </h3>
                                    <ul class="o_ldm_md_day_items">
                                        <li t-foreach="day.items" t-as="item" t-key="item.key">
                                            <button type="button" t-attf-class="o_ldm_md_day_item {{ kindSpine(item) }}"
                                                    t-on-click="() => this.openRow(item)">
                                                <LdmIcon name="kindIcon(item.kind)" title="kindLabel(item.kind)" class="'o_ldm_md_day_icon'"/>
                                                <span class="o_ldm_md_day_text">
                                                    <span class="o_ldm_md_day_label">
                                                        <span class="o_ldm_num" dir="ltr" t-if="hour(item.time)" t-esc="hour(item.time)"/>
                                                        <t t-esc="item.label"/>
                                                    </span>
                                                    <span dir="auto" class="o_ldm_md_hint" t-esc="item.subject"/>
                                                </span>
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                                <div class="o_ldm_md_panel_foot">
                                    <button type="button" class="o_ldm_linkbtn" t-on-click="openAgenda">
                                        <LdmIcon name="'calendar-days'"/>
                                        <span t-esc="label.agendaOpen"/>
                                    </button>
                                </div>
                            </section>
                        </aside>
                    </div>
                </div>
            </div>
        </Layout>
    </t>

</templates>
