<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Clients (office) / group companies (department). SAG's view xmlids are
         kept. The workspace stream adds the "matters by body" panel that
         replaces the old HTML blob; the government stream adds the document
         vault and obligations; the money stream adds fee agreements. -->
    <record id="view_legal_company_kanban" model="ir.ui.view">
        <field name="name">legal.company.kanban</field>
        <field name="model">legal.company</field>
        <field name="arch" type="xml">
            <kanban class="o_ldm_kanban" sample="1">
                <field name="name"/>
                <field name="company_type"/>
                <field name="client_kind"/>
                <field name="lawyer_id"/>
                <field name="pending_tasks_count"/>
                <field name="task_count"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold text-truncate"/>
                        <div class="text-muted small">
                            <field name="company_type" invisible="client_kind == 'individual'"/>
                            <field name="client_kind" invisible="client_kind == 'company'"/>
                        </div>
                        <footer class="pt-1">
                            <span class="small" invisible="not pending_tasks_count">
                                <field name="pending_tasks_count"/> open
                            </span>
                            <span class="small text-muted" invisible="pending_tasks_count">No open matters</span>
                            <field name="lawyer_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_legal_company_tree" model="ir.ui.view">
        <field name="name">legal.company.list</field>
        <field name="model">legal.company</field>
        <field name="arch" type="xml">
            <list string="Clients" sample="1">
                <field name="name"/>
                <field name="company_type" optional="show"/>
                <field name="lawyer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="pending_tasks_count" string="Open matters"/>
                <field name="task_count" optional="hide"/>
                <field name="registration_number" optional="hide"/>
                <field name="tax_number" optional="hide"/>
                <field name="owner_name" optional="hide"/>
                <field name="total_expenses" optional="hide"
                       groups="legal_department_management.group_legal_manager,legal_department_management.group_ldm_auditor,legal_department_management.group_ldm_billing_user"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_legal_company_form" model="ir.ui.view">
        <field name="name">legal.company.form</field>
        <field name="model">legal.company</field>
        <field name="arch" type="xml">
            <form string="Client">
                <field name="currency_id" invisible="1"/>
                <header>
                    <button name="action_create_new_task" string="New matter" type="object" class="btn-primary"
                            groups="legal_department_management.group_ldm_clerk"/>
                    <button name="action_print_company_report" string="Print file" type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <field name="pending_tasks_count" widget="statinfo" string="Open matters"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-archive"
                                context="{'search_default_filter_open': 0}">
                            <field name="task_count" widget="statinfo" string="All matters"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Al-Rafidain Contracting Company"/></h1>
                    </div>
                    <group name="essentials">
                        <group name="essentials_left">
                            <field name="client_kind" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_type" invisible="client_kind == 'individual'"/>
                            <field name="lawyer_id" widget="many2one_avatar_user"/>
                        </group>
                        <group name="essentials_right">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="partner_id" readonly="1" invisible="not partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="matters" string="Matters">
                            <field name="task_ids" readonly="1" context="{'active_test': False}">
                                <list decoration-muted="state in ('done', 'cancelled')">
                                    <field name="task_number"/>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="next_date" widget="remaining_days"/>
                                    <field name="lawyer_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page name="registry" string="Registration">
                            <group>
                                <group name="registry_ids">
                                    <field name="registration_number"/>
                                    <field name="tax_number"/>
                                    <field name="social_security_number"/>
                                    <field name="national_id" invisible="client_kind != 'individual'"/>
                                </group>
                                <group name="registry_more">
                                    <field name="owner_name" invisible="client_kind == 'individual'"/>
                                    <field name="entity_type" invisible="client_kind == 'individual'"/>
                                    <field name="chamber_number" invisible="client_kind == 'individual'"/>
                                    <field name="chamber_grade" invisible="client_kind == 'individual'"/>
                                    <field name="code"/>
                                </group>
                            </group>
                            <group>
                                <field name="address"/>
                            </group>
                        </page>
                        <page name="team" string="Team">
                            <group>
                                <field name="lawyer_ids" widget="many2many_avatar_user"/>
                                <field name="employee_ids" widget="many2many_tags" groups="legal_department_management.group_ldm_hr_team"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes"/>
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_legal_company_search" model="ir.ui.view">
        <field name="name">legal.company.search</field>
        <field name="model">legal.company</field>
        <field name="arch" type="xml">
            <search string="Clients">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('registration_number', 'ilike', self)]"/>
                <field name="lawyer_id"/>
                <field name="tax_number"/>
                <filter string="Mine" name="filter_mine" domain="['|', ('lawyer_id', '=', uid), ('lawyer_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="Companies" name="filter_companies" domain="[('client_kind', '=', 'company')]"/>
                <filter string="Individuals" name="filter_individuals" domain="[('client_kind', '=', 'individual')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Legal form" name="group_type" context="{'group_by': 'company_type'}"/>
                    <filter string="Responsible" name="group_lawyer" context="{'group_by': 'lawyer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_company" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">legal.company</field>
        <field name="path">legal-clients</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_legal_company_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No clients yet</p>
            <p>Add the companies or people you do legal work for. Each one gets its own file of matters.</p>
        </field>
    </record>
</odoo>
