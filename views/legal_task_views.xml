<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The matter: register (list, kanban, calendar, pivot, graph) and the
        cockpit form. The view xmlids are SAG's, kept so that anything
        inheriting them survives the upgrade. The workspace stream adds the
        cockpit widgets (vitals, next step, phase rail, advanced toggle) by
        inheritance; the area streams fill their notebook pages.
    -->
    <record id="view_legal_task_kanban" model="ir.ui.view">
        <field name="name">legal.task.kanban</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" class="o_ldm_view o_ldm_kanban" sample="1">
                <field name="task_number"/>
                <field name="name"/>
                <field name="legal_company_id"/>
                <field name="department_id"/>
                <field name="lawyer_id"/>
                <field name="next_date"/>
                <field name="is_urgent"/>
                <field name="is_overdue"/>
                <field name="approval_state"/>
                <field name="activity_ids"/>
                <field name="kind"/>
                <progressbar field="approval_state" colors='{"to_approve": "info", "rejected": "danger", "approved": "success"}'/>
                <templates>
                    <t t-name="card">
                        <span t-attf-class="o_ldm_kind_marker o_ldm_kind_#{record.kind.raw_value or 'other'}"/>
                        <div class="d-flex align-items-start gap-2">
                            <field name="is_urgent" widget="boolean_favorite" nolabel="1"/>
                            <div class="flex-grow-1 text-truncate">
                                <field name="name" class="fw-bold"/>
                                <div class="text-muted small"><field name="task_number"/></div>
                            </div>
                        </div>
                        <div class="text-truncate small">
                            <field name="legal_company_id"/>
                            <t t-if="record.department_id.raw_value"> · <field name="department_id"/></t>
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center gap-1 small">
                                <field name="next_date" widget="remaining_days" invisible="not next_date"/>
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                            <field name="lawyer_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_legal_task_tree" model="ir.ui.view">
        <field name="name">legal.task.list</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <list string="Matters" sample="1" multi_edit="1" class="o_ldm_view">
                <field name="is_urgent" widget="boolean_favorite" nolabel="1" optional="hide"/>
                <field name="task_number" string="Number" optional="hide"/>
                <field name="display_name" string="Matter"/>
                <field name="name" column_invisible="1"/>
                <field name="legal_company_id"/>
                <field name="department_id" optional="show"/>
                <field name="next_date" widget="remaining_days" optional="show"/>
                <field name="lawyer_id" widget="many2one_avatar_user" optional="show"/>
                <field name="state" widget="ldm_pill"
                       decoration-muted="state in ('draft', 'cancelled')"
                       decoration-primary="state == 'in_progress'"
                       decoration-warning="state == 'pending_docs'"
                       decoration-success="state == 'done'"/>
                <field name="ministry_id" optional="hide"/>
                <field name="kind" optional="hide"/>
                <field name="template_id" optional="hide"/>
                <field name="due_date" optional="hide"/>
                <field name="session_date" optional="hide"/>
                <field name="approval_state" widget="ldm_pill" optional="hide" options="{'stamp': ['approved']}"
                       decoration-info="approval_state == 'to_approve'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"/>
                <field name="court_case_number" optional="hide"/>
                <field name="expenses_amount" sum="Total" optional="hide" groups="legal_department_management.group_legal_manager,legal_department_management.group_ldm_auditor,legal_department_management.group_ldm_billing_user"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="lawyer_ids" widget="many2many_avatar_user" optional="hide"/>
                <field name="date_opened" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_task_calendar" model="ir.ui.view">
        <field name="name">legal.task.calendar</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <calendar js_class="ldm_calendar" string="Matters" date_start="next_date" color="lawyer_id" mode="month" quick_create="0"
                      event_open_popup="1">
                <field name="task_number"/>
                <field name="legal_company_id"/>
                <field name="department_id"/>
                <field name="lawyer_id" avatar_field="avatar_128"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_ldm_task_pivot" model="ir.ui.view">
        <field name="name">legal.task.pivot</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <pivot string="Matters analysis" sample="1" class="o_ldm_view">
                <field name="ministry_id" type="row"/>
                <field name="state" type="col"/>
                <field name="expenses_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ldm_task_graph" model="ir.ui.view">
        <field name="name">legal.task.graph</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <graph string="Matters analysis" type="bar" sample="1" class="o_ldm_view">
                <field name="ministry_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <record id="view_legal_task_form" model="ir.ui.view">
        <field name="name">legal.task.form</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <form string="Matter" class="o_ldm_view">
                <field name="kind" invisible="1"/>
                <field name="approval_state" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_currency_id" invisible="1"/>
                <field name="ldm_can_request_approval" invisible="1"/>
                <field name="ldm_can_decide" invisible="1"/>
                <field name="ldm_is_manager" invisible="1"/>
                <header>
                    <button name="action_request_approval" string="Send for approval" type="object" class="btn-primary"
                            invisible="not ldm_can_request_approval"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="not ldm_can_decide"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="not ldm_can_decide"/>
                    <button name="action_set_in_progress" string="Start" type="object" class="btn-primary"
                            invisible="state != 'draft' or ldm_can_request_approval or approval_state == 'to_approve'"
                            groups="legal_department_management.group_ldm_clerk"/>
                    <button name="action_set_done" string="Close matter" type="object" class="btn-primary"
                            invisible="state not in ('in_progress', 'pending_docs')"
                            groups="legal_department_management.group_ldm_clerk"/>
                    <button name="action_set_in_progress" string="Reopen" type="object"
                            invisible="state not in ('done', 'cancelled') or not ldm_is_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <widget name="web_ribbon" title="Done" bg_color="text-bg-success" invisible="state != 'done'"/>
                    <div class="alert alert-warning mb-3" role="status" invisible="approval_state != 'to_approve'">
                        Waiting for approval<span invisible="not approval_requested_by_id">, sent by <field name="approval_requested_by_id" class="d-inline" readonly="1"/></span>.
                    </div>
                    <div class="alert alert-danger mb-3" role="alert" invisible="approval_state != 'rejected'">
                        Rejected by <field name="approver_id" class="d-inline" readonly="1"/>: <field name="approval_note" class="d-inline" readonly="1"/>
                    </div>
                    <div class="oe_title">
                        <div class="text-muted d-flex flex-wrap gap-3">
                            <field name="task_number" readonly="1"/>
                            <span invisible="kind not in ('litigation', 'execution')">
                                <label for="court_case_number" class="me-1"/><field name="court_case_number" class="d-inline-block" placeholder="e.g. 1234/b/2026"/>
                            </span>
                            <span invisible="kind != 'government'">
                                <label for="reference" class="me-1"/><field name="reference" class="d-inline-block"/>
                            </span>
                        </div>
                        <h1><field name="name" placeholder="e.g. Annual tax clearance for 2026"/></h1>
                    </div>
                    <group name="essentials">
                        <group name="essentials_who">
                            <field name="legal_company_id" options="{'no_quick_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="department_id" options="{'no_quick_create': True}"/>
                        </group>
                        <group name="essentials_when">
                            <field name="lawyer_id" widget="many2one_avatar_user"/>
                            <field name="due_date"/>
                            <field name="session_date" invisible="not session_date"/>
                            <field name="waiting_on" invisible="kind != 'government'"/>
                            <field name="is_urgent" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <field name="properties" columns="2"/>
                    <notebook>
                        <page name="steps" string="Steps">
                            <field name="step_ids" context="{'default_task_id': id}">
                                <list editable="bottom" decoration-muted="state != 'todo'" decoration-danger="is_overdue">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="date_due"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="ldm_pill" decoration-success="state == 'done'"/>
                                    <field name="is_overdue" column_invisible="1"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="documents" string="Documents">
                            <field name="document_ids" context="{'default_task_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="mandatory" optional="show"/>
                                    <field name="state" widget="ldm_pill" options="{'stamp': ['verified']}"
                                           decoration-danger="state in ('missing', 'expired')"
                                           decoration-success="state in ('received', 'verified')"/>
                                    <field name="expiry_date" optional="show"/>
                                    <field name="attachment_id" optional="hide"/>
                                </list>
                            </field>
                            <field name="attachment_ids" widget="many2many_binary" string="Other files"/>
                        </page>
                        <page name="sessions" string="Sessions" invisible="kind not in ('litigation', 'execution')">
                            <field name="hearing_ids" context="{'default_task_id': id, 'default_department_id': department_id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="department_id"/>
                                    <field name="attending_user_id" widget="many2one_avatar_user"/>
                                    <field name="state" widget="ldm_pill"/>
                                    <field name="outcome" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="case" string="Case" invisible="kind not in ('litigation', 'execution')">
                            <group>
                                <group name="case_court">
                                    <field name="court_stage"/>
                                    <field name="our_role"/>
                                    <field name="law_branch"/>
                                </group>
                                <group name="case_value">
                                    <field name="opponent_name"/>
                                    <field name="matter_value"/>
                                    <field name="poa_id"/>
                                </group>
                            </group>
                            <field name="court_stage_ids" context="{'default_task_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage"/>
                                    <field name="department_id"/>
                                    <field name="case_number"/>
                                    <field name="date_filed" optional="show"/>
                                </list>
                            </field>
                            <field name="party_ids" context="{'default_task_id': id}">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="role"/>
                                    <field name="counsel_id" optional="show"/>
                                </list>
                            </field>
                            <field name="judgment_ids" context="{'default_task_id': id}">
                                <list>
                                    <field name="date"/>
                                    <field name="department_id"/>
                                    <field name="result"/>
                                    <field name="notified_date"/>
                                </list>
                            </field>
                            <field name="deadline_ids" context="{'default_task_id': id}">
                                <list editable="bottom" decoration-danger="state == 'open' and remaining_days &lt; 3">
                                    <field name="name"/>
                                    <field name="date_safe"/>
                                    <field name="date_deadline" optional="hide"/>
                                    <field name="remaining_days" optional="show"/>
                                    <field name="state" widget="ldm_pill"/>
                                </list>
                            </field>
                        </page>
                        <page name="contract" string="Contract" invisible="kind != 'contract'">
                            <group>
                                <group>
                                    <field name="counterparty_id"/>
                                    <field name="matter_value" string="Contract value"/>
                                </group>
                                <group>
                                    <field name="contract_start"/>
                                    <field name="contract_end"/>
                                    <field name="renewal_notice_days"/>
                                </group>
                            </group>
                        </page>
                        <page name="opinion" string="Opinion" invisible="kind != 'opinion'">
                            <group>
                                <field name="requesting_unit"/>
                                <field name="question"/>
                                <field name="opinion_number" invisible="not opinion_number"/>
                                <field name="opinion_date" invisible="not opinion_date"/>
                                <field name="supersedes_id" invisible="not supersedes_id"/>
                                <field name="superseded_by_id" invisible="not superseded_by_id"/>
                            </group>
                            <field name="opinion_html" placeholder="Write the opinion here."/>
                        </page>
                        <page name="investigation" string="Investigation" invisible="kind != 'investigation'"
                              groups="legal_department_management.group_ldm_investigations">
                            <group>
                                <group>
                                    <field name="order_number"/>
                                    <field name="order_date"/>
                                    <field name="issuing_authority"/>
                                    <field name="committee_member_ids" widget="many2many_avatar_user"/>
                                </group>
                                <group>
                                    <field name="decision_number"/>
                                    <field name="decision_date"/>
                                    <field name="compensation_amount"/>
                                </group>
                            </group>
                            <group>
                                <field name="employees_concerned"/>
                                <field name="recommendation"/>
                            </group>
                        </page>
                        <page name="money" string="Expenses">
                            <field name="expense_ids" context="{'default_task_id': id}">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="category_id"/>
                                    <field name="name"/>
                                    <field name="receipt_number" optional="show"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="currency_id" optional="hide" groups="base.group_multi_currency"/>
                                    <field name="recoverable" optional="hide" groups="legal_department_management.group_ldm_billing"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="expenses_amount"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="action_details" placeholder="Facts, letter numbers, what was said at the counter..."/>
                        </page>
                    </notebook>
                    <group name="more" string="More" class="o_ldm_more_group">
                        <group name="more_people">
                            <field name="lawyer_ids" widget="many2many_avatar_user"/>
                            <field name="employee_ids" widget="many2many_tags" groups="legal_department_management.group_ldm_hr_team"/>
                            <field name="requester_id"/>
                            <field name="request_id" invisible="not request_id"/>
                            <field name="confidential"/>
                        </group>
                        <group name="more_file">
                            <field name="ministry_id"/>
                            <field name="date_opened"/>
                            <field name="date_submitted" invisible="kind != 'government'"/>
                            <field name="date_closed" invisible="not date_closed"/>
                            <field name="outcome" invisible="not outcome"/>
                            <field name="close_note" invisible="not close_note"/>
                            <field name="approver_id" invisible="approval_state == 'draft'"/>
                            <field name="approval_date" invisible="approval_state == 'draft'"/>
                        </group>
                        <group name="more_accounting" string="Accounting (older records)"
                               invisible="not account_move_id and not account_payment_id and not expense_account_id"
                               groups="account.group_account_invoice,account.group_account_readonly">
                            <field name="expense_account_id"/>
                            <field name="account_move_id"/>
                            <field name="account_payment_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_legal_task_search" model="ir.ui.view">
        <field name="name">legal.task.search</field>
        <field name="model">legal.task</field>
        <field name="arch" type="xml">
            <search string="Matters">
                <field name="name" string="Matter" filter_domain="['|', ('name', 'ilike', self), ('task_number', 'ilike', self)]"/>
                <field name="task_number"/>
                <field name="legal_company_id"/>
                <field name="department_id"/>
                <field name="ministry_id"/>
                <field name="lawyer_id"/>
                <field name="lawyer_ids"/>
                <field name="court_case_number"/>
                <filter string="My matters" name="filter_my_tasks"
                        domain="['|', ('lawyer_id', '=', uid), ('lawyer_ids', 'in', [uid])]"/>
                <separator/>
                <filter string="Open" name="filter_open" domain="[('state', 'in', ('draft', 'in_progress', 'pending_docs'))]"/>
                <filter string="In progress" name="filter_in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Waiting" name="filter_pending_docs" domain="[('state', '=', 'pending_docs')]"/>
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Overdue" name="filter_overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="Urgent" name="filter_urgent" domain="[('is_urgent', '=', True)]"/>
                <filter string="Missing documents" name="filter_missing_docs" domain="[('missing_document_count', '&gt;', 0)]"/>
                <filter string="Waiting on the body" name="filter_at_body" domain="[('waiting_on', 'in', ('body', 'verification'))]"
                        groups="legal_department_management.group_ldm_government"/>
                <filter string="Confidential" name="filter_confidential" domain="[('confidential', '=', True)]"/>
                <separator/>
                <filter string="Awaiting approval" name="filter_to_approve" domain="[('approval_state', '=', 'to_approve')]"
                        groups="legal_department_management.group_ldm_approvals"/>
                <filter string="Approved" name="filter_approved" domain="[('approval_state', '=', 'approved')]"
                        groups="legal_department_management.group_ldm_approvals"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Client" name="group_company" context="{'group_by': 'legal_company_id'}"/>
                    <filter string="Ministry" name="group_ministry" context="{'group_by': 'ministry_id'}"/>
                    <filter string="Body or court" name="group_dept" context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Kind" name="group_kind" context="{'group_by': 'kind'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by': 'lawyer_id'}"/>
                    <filter string="Approval" name="group_approval" context="{'group_by': 'approval_state'}"
                            groups="legal_department_management.group_ldm_approvals"/>
                </group>
                <searchpanel>
                    <field name="state" icon="fa-flag" enable_counters="1"/>
                    <field name="kind" icon="fa-folder-open" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_legal_task" model="ir.actions.act_window">
        <field name="name">Matters</field>
        <field name="res_model">legal.task</field>
        <field name="path">matters</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_legal_task_search"/>
        <field name="context">{'search_default_filter_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No matters here yet</p>
            <p>Open the first one with <b>New matter</b>: choose its type and client, and the steps and documents are filled in for you.</p>
        </field>
    </record>

    <record id="action_legal_task_to_approve" model="ir.actions.act_window">
        <field name="name">Awaiting approval</field>
        <field name="res_model">legal.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', '=', 'to_approve')]</field>
        <field name="search_view_id" ref="view_legal_task_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for approval</p>
            <p>Matters sent for approval appear here.</p>
        </field>
    </record>

    <record id="action_ldm_task_decided" model="ir.actions.act_window">
        <field name="name">Decided</field>
        <field name="res_model">legal.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('approval_state', 'in', ('approved', 'rejected'))]</field>
        <field name="search_view_id" ref="view_legal_task_search"/>
    </record>

    <record id="action_ldm_task_analysis" model="ir.actions.act_window">
        <field name="name">Matters analysis</field>
        <field name="res_model">legal.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_legal_task_search"/>
    </record>

    <!-- The less frequent actions live in the gear menu, and in the list's
         Actions menu for several matters at once. Role-gated so that an
         auditor is offered none of them. -->
    <record id="action_server_ldm_request_approval" model="ir.actions.server">
        <field name="name">Send for approval</field>
        <field name="model_id" ref="model_legal_task"/>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_ldm_clerk'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_request_approval()</field>
    </record>
    <record id="action_server_ldm_cancel" model="ir.actions.server">
        <field name="name">Cancel matter</field>
        <field name="model_id" ref="model_legal_task"/>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('group_legal_user'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_set_cancelled()</field>
    </record>
    <record id="action_server_ldm_reset" model="ir.actions.server">
        <field name="name">Back to New</field>
        <field name="model_id" ref="model_legal_task"/>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('group_legal_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_set_draft()</field>
    </record>
    <record id="action_server_ldm_reset_approval" model="ir.actions.server">
        <field name="name">Reset approval</field>
        <field name="model_id" ref="model_legal_task"/>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_view_types">form</field>
        <field name="group_ids" eval="[(4, ref('group_legal_manager'))]"/>
