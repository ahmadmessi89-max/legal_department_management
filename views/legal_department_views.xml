<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Ministries, government bodies and courts (SPEC 5.6). The xmlids are
        SAG's and are kept: view_legal_ministry_*, view_legal_department_*,
        action_legal_ministry, action_legal_department. Owned by the gov
        stream. The read-only directory for clerks is in gov_views.xml.
    -->

    <!-- ==================== Ministries and authorities ==================== -->
    <record id="view_legal_ministry_list" model="ir.ui.view">
        <field name="name">legal.ministry.list</field>
        <field name="model">legal.ministry</field>
        <field name="arch" type="xml">
            <list string="Ministries and authorities" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="body_kind" optional="show"/>
                <field name="department_count" string="Bodies"/>
                <field name="task_count" string="Matters" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="code" optional="hide"/>
                <field name="governorate" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_ministry_form" model="ir.ui.view">
        <field name="name">legal.ministry.form</field>
        <field name="model">legal.ministry</field>
        <field name="arch" type="xml">
            <form string="Ministry or authority">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_departments" type="object" class="oe_stat_button" icon="fa-university">
                            <field name="department_count" string="Bodies" widget="statinfo"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <field name="task_count" string="Matters" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ministry of Finance"/></h1>
                    </div>
                    <group>
                        <group name="identity">
                            <field name="body_kind"/>
                            <field name="governorate"/>
                            <field name="code"/>
                        </group>
                        <group name="contact">
                            <field name="phone" widget="phone"/>
                            <field name="website" widget="url"/>
                            <field name="resource_calendar_id" options="{'no_create': True}"
                                   placeholder="The legal working calendar"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="departments" string="Bodies">
                            <field name="department_ids" context="{'default_ministry_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="body_kind"/>
                                    <field name="phone" optional="show"/>
                                    <field name="code" optional="hide"/>
                                    <field name="open_task_count" string="Open matters" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <group>
                                <field name="address"/>
                            </group>
                            <field name="notes" placeholder="Letters this authority expects, who signs them, where to send them..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_legal_ministry_search" model="ir.ui.view">
        <field name="name">legal.ministry.search</field>
        <field name="model">legal.ministry</field>
        <field name="arch" type="xml">
            <search string="Ministries and authorities">
                <field name="name" filter_domain="[('display_name', 'ilike', self)]"/>
                <field name="code"/>
                <filter string="Ministries" name="filter_ministries" domain="[('body_kind', '=', 'ministry')]"/>
                <filter string="Commissions and unions" name="filter_commissions"
                        domain="[('body_kind', 'in', ('commission', 'union'))]"/>
                <filter string="Judicial councils" name="filter_judicial" domain="[('body_kind', '=', 'judicial')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Kind" name="group_kind" context="{'group_by': 'body_kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_legal_ministry" model="ir.actions.act_window">
        <field name="name">Ministries and authorities</field>
        <field name="res_model">legal.ministry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_legal_ministry_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ministries yet</p>
            <p>Add the ministries and authorities your bodies belong to, or load the Iraqi reference library from Settings.</p>
        </field>
    </record>

    <!-- ==================== Bodies and courts ==================== -->
    <record id="view_legal_department_list" model="ir.ui.view">
        <field name="name">legal.department.list</field>
        <field name="model">legal.department</field>
        <field name="arch" type="xml">
            <list string="Bodies and courts" sample="1">
                <field name="name"/>
                <field name="ministry_id"/>
                <field name="body_kind" optional="show"/>
                <field name="governorate" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="open_task_count" string="Open matters" optional="show" width="110px"/>
                <field name="court_degree" optional="hide"/>
                <field name="parent_id" optional="hide"/>
                <field name="working_hours" optional="hide"/>
                <field name="target_days" optional="hide"/>
                <field name="code" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_legal_department_form" model="ir.ui.view">
        <field name="name">legal.department.form</field>
        <field name="model">legal.department</field>
        <field name="arch" type="xml">
            <form string="Body or court">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_open_tasks" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <field name="open_task_count" string="Open matters" widget="statinfo"/>
                        </button>
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="task_count" string="All matters" widget="statinfo"/>
                        </button>
                        <button name="action_view_templates" type="object" class="oe_stat_button" icon="fa-list-ul"
                                invisible="body_kind == 'court' and not template_count"
                                groups="legal_department_management.group_ldm_government">
                            <field name="template_count" string="Services" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. General Commission for Taxes"/></h1>
                        <field name="ministry_id" placeholder="Ministry or authority" options="{'no_quick_create': True}"/>
                    </div>
                    <group>
                        <group name="identity">
                            <field name="body_kind"/>
                            <field name="court_degree" invisible="body_kind not in ('court', 'execution')"/>
                            <field name="parent_id" invisible="body_kind not in ('court', 'execution')"
                                   domain="[('body_kind', '=', 'court'), ('id', '!=', id)]"
                                   options="{'no_create': True}"/>
                            <field name="governorate"/>
                            <field name="code"/>
                        </group>
                        <group name="practical">
                            <field name="phone" widget="phone" options="{'enable_sms': False}"/>
                            <field name="working_hours" placeholder="e.g. from 8:00 to 14:00, Sunday to Thursday"/>
                            <field name="target_days" invisible="body_kind == 'court'"/>
                            <field name="location_url" widget="url" placeholder="Link to the location on a map"/>
                            <field name="resource_calendar_id" options="{'no_create': True}"
                                   placeholder="The ministry's or the legal calendar"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="contacts" string="Contacts">
                            <field name="contact_ids">
                                <kanban>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="phone"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name" class="fw-bold"/>
                                            <field name="role" class="text-muted small"/>
                                            <field name="phone" widget="phone" options="{'enable_sms': False}"/>
                                        </t>
                                    </templates>
                                </kanban>
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="phone"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                            <group invisible="not contact_person">
                                <field name="contact_person"/>
                            </group>
                        </page>
                        <page name="services" string="Services" groups="legal_department_management.group_ldm_government"
                              invisible="body_kind == 'court' and not template_ids">
                            <field name="template_ids" context="{'default_department_id': id, 'default_kind': 'government'}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="duration_days" optional="show"/>
                                    <field name="track_coverage" optional="show"/>
                                    <field name="usage_count" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="lower_courts" string="Courts below"
                              invisible="body_kind != 'court' or not lower_court_ids">
                            <field name="lower_court_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="court_degree"/>
                                    <field name="governorate" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page name="letters" string="Letters">
                            <group>
                                <field name="addressee_title"
                                       placeholder="e.g. The Director General of the General Commission for Taxes"/>
                                <field name="address"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="What the counter asks for, who to ask, what to avoid..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_legal_department_search" model="ir.ui.view">
        <field name="name">legal.department.search</field>
        <field name="model">legal.department</field>
        <field name="arch" type="xml">
            <search string="Bodies and courts">
                <field name="name" string="Body or court" filter_domain="[('display_name', 'ilike', self)]"/>
                <field name="ministry_id"/>
                <field name="contact_ids" string="Contact"/>
                <field name="code"/>
                <filter string="Government bodies" name="filter_government"
                        domain="[('body_kind', 'in', ('government', 'registry', 'notary', 'other'))]"/>
                <filter string="Courts" name="filter_courts" domain="[('body_kind', '=', 'court')]"/>
                <filter string="Execution directorates" name="filter_execution" domain="[('body_kind', '=', 'execution')]"/>
                <separator/>
                <filter string="First instance" name="filter_first_instance"
                        domain="[('court_degree', 'in', ('first_instance', 'first_instance_final'))]"/>
                <filter string="Appeal" name="filter_appeal" domain="[('court_degree', '=', 'appeal')]"/>
                <filter string="Cassation" name="filter_cassation" domain="[('court_degree', '=', 'cassation')]"/>
                <separator/>
                <filter string="Baghdad" name="filter_baghdad" domain="[('governorate', '=', 'baghdad')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Ministry" name="group_by_ministry" context="{'group_by': 'ministry_id'}"/>
                    <filter string="Kind" name="group_by_kind" context="{'group_by': 'body_kind'}"/>
                    <filter string="Court degree" name="group_by_degree" context="{'group_by': 'court_degree'}"/>
                    <filter string="Governorate" name="group_by_governorate" context="{'group_by': 'governorate'}"/>
                </group>
                <searchpanel>
                    <field name="ministry_id" string="Ministry" icon="fa-university" enable_counters="1"/>
                    <field name="body_kind" icon="fa-building-o" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_legal_department" model="ir.actions.act_window">
        <field name="name">Bodies and courts</field>
        <field name="res_model">legal.department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_legal_department_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No bodies or courts yet</p>
            <p>Add the government bodies and courts you work with, with their hours, contacts and the services they offer, or load the Iraqi reference library from Settings.</p>
        </field>
    </record>
</odoo>
