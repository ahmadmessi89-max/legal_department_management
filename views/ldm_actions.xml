<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Window actions for the models added in 19.0.7.0.0. The foundation
         declares them so the menus can point at them; each stream redefines
         its actions (same xmlid) once it ships real views. -->
    <record id="action_ldm_task_template" model="ir.actions.act_window">
        <field name="name">Matter types</field>
        <field name="res_model">legal.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No matter types yet</p>
            <p>A matter type fills in the steps, the documents to collect and the target date whenever a matter of that type is opened.</p>
        </field>
    </record>
    <record id="action_ldm_agenda" model="ir.actions.act_window">
        <field name="name">Agenda</field>
        <field name="res_model">legal.hearing</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'planned')]</field>
    </record>
    <record id="action_ldm_deadline" model="ir.actions.act_window">
        <field name="name">Deadlines</field>
        <field name="res_model">legal.deadline</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>
    <record id="action_ldm_poa" model="ir.actions.act_window">
        <field name="name">Powers of attorney</field>
        <field name="res_model">legal.poa</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_correspondence" model="ir.actions.act_window">
        <field name="name">Correspondence</field>
        <field name="res_model">legal.correspondence</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_request" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">legal.request</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_request_mine" model="ir.actions.act_window">
        <field name="name">My requests</field>
        <field name="res_model">legal.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask the legal team</p>
            <p>Describe what you need, for which company and by when. You can follow the answer here.</p>
        </field>
    </record>
    <record id="action_ldm_company_document" model="ir.actions.act_window">
        <field name="name">Company documents</field>
        <field name="res_model">legal.company.document</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_obligation" model="ir.actions.act_window">
        <field name="name">Recurring obligations</field>
        <field name="res_model">legal.obligation</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_engagement" model="ir.actions.act_window">
        <field name="name">Fee agreements</field>
        <field name="res_model">legal.engagement</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_to_invoice" model="ir.actions.act_window">
        <field name="name">To invoice</field>
        <field name="res_model">legal.engagement.line</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'due')]</field>
    </record>
    <record id="action_ldm_time_entry" model="ir.actions.act_window">
        <field name="name">Time</field>
        <field name="res_model">legal.time.entry</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_expense" model="ir.actions.act_window">
        <field name="name">Expenses</field>
        <field name="res_model">legal.task.expense</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_document_type" model="ir.actions.act_window">
        <field name="name">Document types</field>
        <field name="res_model">legal.document.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_appeal_rule" model="ir.actions.act_window">
        <field name="name">Statutory periods</field>
        <field name="res_model">legal.appeal.rule</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_expense_category" model="ir.actions.act_window">
        <field name="name">Expense categories</field>
        <field name="res_model">legal.expense.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_letter_template" model="ir.actions.act_window">
        <field name="name">Letter templates</field>
        <field name="res_model">legal.letter.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_conflict_check" model="ir.actions.act_window">
        <field name="name">Conflict checks</field>
        <field name="res_model">legal.conflict.check</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_working_calendar" model="ir.actions.act_window">
        <field name="name">Working days and holidays</field>
        <field name="res_model">resource.calendar</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="ldm_calendar_iraq"/>
    </record>
    <record id="action_ldm_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'legal_department_management', 'bin_size': False}</field>
    </record>
    <record id="action_ldm_holiday" model="ir.actions.act_window">
        <field name="name">Public holidays</field>
        <field name="res_model">legal.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No holidays entered</p>
            <p>Enter the Eid dates when the endowment offices announce them, and any day the Council of Ministers adds. Deadlines that end on a holiday move to the next working day.</p>
        </field>
    </record>
    <record id="action_ldm_guarantee" model="ir.actions.act_window">
        <field name="name">Letters of guarantee</field>
        <field name="res_model">legal.guarantee</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_client_fund" model="ir.actions.act_window">
        <field name="name">Client money</field>
        <field name="res_model">legal.client.fund.line</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_advance" model="ir.actions.act_window">
        <field name="name">Cash advances</field>
        <field name="res_model">legal.advance</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_ldm_body_directory" model="ir.actions.act_window">
        <field name="name">Bodies and courts</field>
        <field name="res_model">legal.department</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>
    <record id="action_ldm_expense_analysis" model="ir.actions.act_window">
        <field name="name">Expenses analysis</field>
        <field name="res_model">legal.task.expense</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
