<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legal_general_report_wizard_form" model="ir.ui.view">
        <field name="name">legal.general.report.wizard.form</field>
        <field name="model">legal.general.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Oversight report" class="o_ldm_view">
                <field name="task_domain" invisible="1"/>
                <div class="alert alert-info mb-3" role="status" invisible="not selection_note">
                    <field name="selection_note" class="d-inline"/>
                </div>
                <group>
                    <field name="filter_state" widget="radio" options="{'horizontal': true}"/>
                    <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"
                           placeholder="Every client"/>
                    <field name="group_by_company"/>
                </group>
                <group string="Narrow down (optional)">
                        <field name="filter_lawyer_id" options="{'no_create': True}" placeholder="Everyone"/>
                        <field name="filter_department_id" options="{'no_create': True}" placeholder="Every body or court"/>
                        <label for="date_from" string="Target or next date"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="date_from" placeholder="From" class="w-auto"/>
                            <span>–</span>
                            <field name="date_to" placeholder="To" class="w-auto"/>
                        </div>
                        <field name="filter_task_ids" widget="many2many_tags" invisible="not filter_task_ids"
                               options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_print_general_report" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Reporting menu entry (xmlid kept from 19.0.6.3.0). -->
    <record id="action_legal_general_report_wizard" model="ir.actions.act_window">
        <field name="name">Oversight report</field>
        <field name="res_model">legal.general.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- The same dialog from the Matters list: it takes the selection, or the
         whole filtered list. -->
    <record id="action_ldm_oversight_from_matters" model="ir.actions.act_window">
        <field name="name">Oversight report</field>
        <field name="res_model">legal.general.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_legal_task"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('group_legal_manager')), (4, ref('group_ldm_auditor'))]"/>
    </record>
</odoo>
